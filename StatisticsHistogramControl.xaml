<UserControl x:Class="SqlXmlAnalyzer.StatisticsHistogramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="950"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Information -->
        <materialDesign:Card Grid.Row="0" Padding="12" materialDesign:ElevationAssist.Elevation="Dp1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Foreground="{DynamicResource MaterialDesignPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="参数嗅探与真实统计直方图分析" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="本工具提取执行计划中的编译/运行时参数值。导入真实的统计直方图可精准对比评估参数分布偏差和 Cardinality Estimation 失真。" 
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="#0A0078D7" BorderBrush="{DynamicResource MaterialDesignPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="12,0,0,0">
                    <TextBlock x:Name="TxtStatus" Text="当前显示：概念性教学模拟图表" FontSize="11.5" Foreground="{DynamicResource MaterialDesignPrimaryBrush}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!-- 2. Selected Parameter Info & Estimates (Side-by-Side Comparison Panel) -->
        <materialDesign:Card Grid.Row="1" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2" Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Parameter Header -->
                    <RowDefinition Height="Auto"/> <!-- Side-by-Side Cards -->
                    <RowDefinition Height="Auto"/> <!-- Estimates Details (collapsed by default) -->
                </Grid.RowDefinitions>

                <!-- Parameter Header Info -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CodeParentheses" Width="20" Height="20" Foreground="{DynamicResource MaterialDesignPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="当前检测参数:" FontWeight="SemiBold" FontSize="13" Foreground="Gray" Margin="8,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtParamName" Text="@Param1" Foreground="{DynamicResource MaterialDesignPrimaryBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Ratio Badge -->
                    <Border Grid.Column="1" x:Name="PanelSniffingRatio" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="12" Padding="10,4" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertDecagramOutline" Width="16" Height="16" Foreground="#E65100" VerticalAlignment="Center"/>
                            <TextBlock Text="估算值偏离比: " FontSize="11" Foreground="#E65100" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSniffingRatio" Text="1.0 倍" Foreground="#D32F2F" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Side-by-Side Cards -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Compiled Parameter Card -->
                    <Border Grid.Column="0" Background="#0A1E88E5" BorderBrush="#1E88E5" BorderThickness="1,1,1,3" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="SettingsOutline" Width="16" Height="16" Foreground="#1976D2" VerticalAlignment="Center"/>
                                <TextBlock Text="编译期参数 (Compiled Parameter)" FontSize="11" Foreground="#1976D2" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="值: " FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtCompiledValue" Text="100" FontSize="20" FontWeight="Bold" Foreground="#1E88E5" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Runtime Parameter Card -->
                    <Border Grid.Column="2" Background="#0AD32F2F" BorderBrush="#D32F2F" BorderThickness="1,1,1,3" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="#D32F2F" VerticalAlignment="Center"/>
                                <TextBlock Text="运行时参数 (Runtime Parameter)" FontSize="11" Foreground="#D32F2F" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="值: " FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtRuntimeValue" Text="5000" FontSize="20" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Estimates Info (visible after importing stats) -->
                <Grid Grid.Row="2" Margin="0,8,0,0" x:Name="PanelEstimates" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#050078D7" BorderThickness="1,0,0,0" BorderBrush="#1E88E5" Padding="8,4" CornerRadius="0,2,2,0">
                        <StackPanel>
                            <TextBlock Text="[编译值估算细节]" FontSize="11" Foreground="#1E88E5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCompiledEstimate" Text="估算返回行数: N/A (匹配方式: N/A)" FontSize="12" FontWeight="SemiBold" Foreground="#1E88E5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#05D32F2F" BorderThickness="1,0,0,0" BorderBrush="#D32F2F" Padding="8,4" CornerRadius="0,2,2,0">
                        <StackPanel>
                            <TextBlock Text="[运行值估算细节]" FontSize="11" Foreground="#D32F2F" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtRuntimeEstimate" Text="估算返回行数: N/A (匹配方式: N/A)" FontSize="12" FontWeight="SemiBold" Foreground="#E53935" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- 3. Main Workspace Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Canvas Area & OptimizerStatsUsage List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Top: Canvas Area -->
                <materialDesign:Card Grid.Row="0" materialDesign:ElevationAssist.Elevation="Dp1" ClipToBounds="True" Background="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <!-- Y Axis Label -->
                        <TextBlock Text="频&#x0a;数&#x0a;(Rows)" FontSize="10" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0" TextAlignment="Center"/>

                        <!-- X Axis Label -->
                        <TextBlock Text="直方图键值分布范围 (RANGE_HI_KEY)" FontSize="10" Foreground="Gray" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <!-- Drawing Canvas -->
                        <Canvas x:Name="DrawCanvas" Margin="32,12,12,28" SizeChanged="DrawCanvas_SizeChanged">
                            <!-- Grid Lines and Bars will be drawn in code-behind -->
                        </Canvas>
                    </Grid>
                </materialDesign:Card>

                <!-- Bottom: OptimizerStatsUsage List -->
                <materialDesign:Card Grid.Row="2" Padding="12" materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="16" Height="16" Foreground="{DynamicResource MaterialDesignPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="优化器统计信息使用情况 (OptimizerStatsUsage)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" x:Name="GridStatsUsage" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="表名" Binding="{Binding Table}" Width="2*"/>
                                <DataGridTextColumn Header="统计信息项" Binding="{Binding Statistics}" Width="2*"/>
                                <DataGridTextColumn Header="最后更新时间" Binding="{Binding LastUpdate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.5*"/>
                                <DataGridTextColumn Header="更新账龄 (天)" Binding="{Binding AgeInDays}" Width="*"/>
                                <DataGridTextColumn Header="修改计数" Binding="{Binding ModificationCount, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="采样比例" Binding="{Binding SamplingPercent, StringFormat={}{0:F1}%}" Width="*"/>
                                <DataGridTemplateColumn Header="健康状态" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="4,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#388E3C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                 <Setter Property="Background" Value="#F57C00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                 <Setter Property="Background" Value="#D32F2F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Right: DBCC SHOW_STATISTICS Import Panel -->
            <materialDesign:Card Grid.Column="2" Padding="12" materialDesign:ElevationAssist.Elevation="Dp2" Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Import" Width="16" Height="16" Foreground="{DynamicResource MaterialDesignPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="导入真实统计信息" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource MaterialDesignBody}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Text="在 SSMS 中执行 DBCC SHOW_STATISTICS('表名', '索引或统计名')。全选并复制结果集 3 (直方图数据格) 并粘贴到下方：" 
                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,8" LineHeight="14"/>

                    <TextBox Grid.Row="2" x:Name="TxtStatsInput" 
                             AcceptsReturn="True" 
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" 
                             FontSize="10.5" 
                             Background="#08000000" 
                             BorderBrush="{DynamicResource MaterialDesignDivider}"
                             Padding="6"
                             ToolTip="在此粘贴直方图数据列，首行必须包含 RANGE_HI_KEY, RANGE_ROWS 等字段名"/>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="BtnApplyStats" Content="🔄 载入并绘制真实直方图" Click="BtnApplyStats_Click" Height="36" FontWeight="SemiBold" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button x:Name="BtnClearStats" Content="❌ 清除并恢复模拟" Click="BtnClearStats_Click" Margin="0,6,0,0" Height="24" FontSize="11" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
