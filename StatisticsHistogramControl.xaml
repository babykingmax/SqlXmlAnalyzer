<UserControl x:Class="SqlXmlAnalyzer.StatisticsHistogramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800"
             Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Information -->
        <Border Grid.Row="0" Background="#F5F7FA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="参数嗅探统计直方图 (Mock Histogram Visualization)" FontWeight="Bold" FontSize="14" Foreground="#37474F"/>
                <TextBlock Text="该视图以图形化方式模拟显示统计信息直方图 (Statistics Histogram)，并标注编译时参数与运行时参数在数据分布中的位置，帮助诊断 Cardinality Estimation 失真原因。" 
                           Foreground="#546E7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Selected Parameter Info -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="参数名称: " FontWeight="SemiBold" Foreground="#37474F"/>
                <TextBlock x:Name="TxtParamName" Text="@Param1" Foreground="#0078D7" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="12" Height="12" Fill="#1976D2" Margin="0,0,6,0"/>
                <TextBlock Text="编译值 (Compiled): " FontWeight="SemiBold" Foreground="#37474F"/>
                <TextBlock x:Name="TxtCompiledValue" Text="100" Foreground="#1976D2" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="12" Height="12" Fill="#D32F2F" Margin="0,0,6,0"/>
                <TextBlock Text="运行值 (Runtime): " FontWeight="SemiBold" Foreground="#37474F"/>
                <TextBlock x:Name="TxtRuntimeValue" Text="5000" Foreground="#D32F2F" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Histogram Canvas Area -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <!-- Y Axis Label -->
                <TextBlock Text="行&#x0a;数&#x0a;(EQ_ROWS)" FontSize="10" Foreground="#78909C" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" TextAlignment="Center"/>
                
                <!-- X Axis Label -->
                <TextBlock Text="数据分布范围 (RANGE_HI_KEY)" FontSize="10" Foreground="#78909C" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- Drawing Canvas -->
                <Canvas x:Name="DrawCanvas" Margin="30,10,10,25" SizeChanged="DrawCanvas_SizeChanged">
                    <!-- Grid Lines and Bars will be drawn in code-behind -->
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
