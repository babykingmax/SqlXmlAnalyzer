<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify">

    <!-- 统一语义化颜色系统 (Semantic Colors) -->
    
    <!-- 1. 致命 / 错误 (Critical) -->
    <Color x:Key="CriticalColor">#D32F2F</Color>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    
    <!-- 2. 警告 / 注意 (Warning) -->
    <Color x:Key="WarningColor">#F57C00</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    
    <!-- 3. 信息 / 提示 (Info) -->
    <Color x:Key="InfoColor">#1976D2</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    
    <!-- 4. 正常 / 良好 (Good) -->
    <Color x:Key="GoodColor">#388E3C</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    
    <!-- 5. 特殊视觉 (如全表扫描标红) -->
    <Color x:Key="AlertHighlightColor">#FF0000</Color>
    <SolidColorBrush x:Key="AlertHighlightBrush" Color="{StaticResource AlertHighlightColor}" />

    <!-- ============================================== -->
    <!-- Nodify 控件防全局样式污染保护 -->
    <!-- ============================================== -->
    <Style TargetType="nodify:Node" BasedOn="{StaticResource {x:Type nodify:Node}}">
        <!-- 避免继承 Material 的全局卡片大阴影，防止由于大量节点渲染导致性能掉帧 -->
    </Style>

</ResourceDictionary>
