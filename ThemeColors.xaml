<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify">

    <!-- 统一语义化颜色系统 (Semantic Colors) -->
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCEBFA"/>
    <SolidColorBrush x:Key="PlanTooltipSurfaceBrush" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#00519E"/>
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#E2E5E9"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#56606C"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF4D0"/>
    <SolidColorBrush x:Key="CriticalSurfaceBrush" Color="#FCE8E8"/>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template"><Setter.Value>
            <ControlTemplate><Rectangle Margin="-2" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" StrokeDashArray="2 1" SnapsToDevicePixels="True"/></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    
    <!-- 1. 致命 / 错误 (Critical) -->
    <Color x:Key="CriticalColor">#D32F2F</Color>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    
    <!-- 2. 警告 / 注意 (Warning) -->
    <Color x:Key="WarningColor">#F57C00</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    
    <!-- 3. 信息 / 提示 (Info) -->
    <Color x:Key="InfoColor">#1976D2</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    
    <!-- 4. 正常 / 良好 (Good) -->
    <Color x:Key="GoodColor">#388E3C</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    
    <!-- 5. 特殊视觉 (如全表扫描标红) -->
    <Color x:Key="AlertHighlightColor">#FF0000</Color>
    <SolidColorBrush x:Key="AlertHighlightBrush" Color="{StaticResource AlertHighlightColor}" />

    <!-- ============================================== -->
    <!-- Nodify 控件防全局样式污染保护 -->
    <!-- ============================================== -->
    <Style TargetType="nodify:Node" BasedOn="{StaticResource {x:Type nodify:Node}}">
        <!-- 避免继承 Material 的全局卡片大阴影，防止由于大量节点渲染导致性能掉帧 -->
    </Style>

</ResourceDictionary>
