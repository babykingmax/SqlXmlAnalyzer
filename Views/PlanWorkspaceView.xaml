<UserControl x:Class="SqlXmlAnalyzer.Views.PlanWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SqlXmlAnalyzer"
             xmlns:workspace="clr-namespace:SqlXmlAnalyzer.Core.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Normal">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MainWindowResources.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="WorkspacePane" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border x:Name="Pane" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
                                <ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="Pane" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource BackgroundBrush}"/><Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/>
            </Style>
            <Style x:Key="DetailHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,14,0,5"/>
            </Style>
            <Style x:Key="CheckFailureStatusText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Style.Triggers><DataTrigger Binding="{Binding PlanWorkspace.HasFailedChecks, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
            </Style>
            <ControlTemplate x:Key="GraphContentOnlyTemplate" TargetType="TabControl">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </ControlTemplate>
            <Style x:Key="CompactAuxiliaryPane" TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ToggleButton Style="{x:Null}" AutomationProperties.Name="展开或收起 SQL、XML、参数统计与改写" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><ContentPresenter VerticalAlignment="Center" Margin="4,0"/></Border></ControlTemplate></ToggleButton.Template>
                            <DockPanel><TextBlock x:Name="AuxiliaryArrow" Text="▸" Width="18"/><ContentPresenter ContentSource="Header"/></DockPanel>
                        </ToggleButton>
                        <ContentPresenter x:Name="AuxiliaryBody" Grid.Row="1" ContentSource="Content" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="AuxiliaryBody" Property="Visibility" Value="Visible"/><Setter TargetName="AuxiliaryArrow" Property="Text" Value="▾"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="10,6"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter x:Name="TabHeader" ContentSource="Header" TextElement.Foreground="{DynamicResource SecondaryTextBrush}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="WorkspaceRoot" Margin="4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="WorkspaceHeader" Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2,4,6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition x:Name="HeaderPrimaryRow" Height="32"/><RowDefinition x:Name="HeaderSecondaryRow" Height="32"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="60"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*" MinWidth="120"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PlanWorkspace.FileSummary, Mode=OneWay}" ToolTip="{Binding PlanWorkspace.Context, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="批次" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="2" x:Name="BatchSelector" AutomationProperties.Name="批次" ItemsSource="{Binding PlanWorkspace.Batches, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SelectedBatch, Mode=TwoWay}" DisplayMemberPath="Key.BatchOrdinal"/>
                    <TextBlock Grid.Column="3" Text="语句" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox Grid.Column="4" x:Name="StatementSelector" AutomationProperties.Name="语句与计划范围" ItemsSource="{Binding PlanWorkspace.Statements, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SelectedStatement, Mode=TwoWay}" DisplayMemberPath="DisplayName" ToolTip="{Binding PlanWorkspace.SelectedStatement.DisplayName, Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding PlanWorkspace.AnalysisSummary, Mode=OneWay}" Style="{StaticResource CheckFailureStatusText}" ToolTip="{Binding PlanWorkspace.ConfigurationStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel x:Name="HeaderActions" Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Button Content="重新分析" AutomationProperties.Name="按当前规则配置重新分析" Command="{x:Static workspace:WorkspaceCommands.ReanalyzePlan}"
                            Visibility="{Binding PlanWorkspace.NeedsConfigurationReanalysis, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Padding="9,2" Margin="0,0,8,0"/>
                    <Button x:Name="GraphPaneButton" Content="计划图" Click="ShowGraph_Click" Padding="9,2" Margin="0" ToolTip="返回计划图"/>
                    <Button x:Name="HotspotsPaneButton" Content="热点" Click="ShowHotspots_Click" Padding="9,2" Margin="4,0,0,0" Visibility="Collapsed" ToolTip="打开热点算子表"/>
                    <Button x:Name="IssuesPaneButton" Content="问题" Click="ToggleIssues_Click" Padding="9,2" Margin="4,0,0,0" ToolTip="打开或收起问题侧栏"/>
                    <Button x:Name="DetailsPaneButton" Content="详情" Click="ToggleDetails_Click" Padding="9,2" Margin="4,0,0,0" ToolTip="打开或收起详情侧栏"/>
                    <Button Content="布局" Click="LayoutMenu_Click" Padding="9,2" Margin="4,0,0,0" ToolTip="恢复默认布局"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="PlanContentGrid" Margin="0,6,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Expander x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource WorkspacePane}" IsExpanded="True" AutomationProperties.Name="问题与检查侧栏" Expanded="LeftPanel_Expanded" Collapsed="LeftPanel_Collapsed">
                <TabControl x:Name="IssuesTabs">
                    <TabItem x:Name="FindingsTab" Header="问题">
                        <Grid Margin="6">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding PlanWorkspace.FindingsSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <TextBox Grid.Row="1" Text="{Binding PlanWorkspace.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索诊断问题" ToolTip="搜索规则、问题或对象" Margin="0,0,0,6"/>
                            <DockPanel Grid.Row="2" Margin="0,0,0,6"><TextBlock Text="严重度" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding PlanWorkspace.SeverityFilters, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SeverityFilter, Mode=TwoWay}" AutomationProperties.Name="诊断严重度筛选"/></DockPanel>
                            <Grid Grid.Row="3">
                                <DataGrid x:Name="DiagnosticIssuesGrid" AutomationProperties.Name="诊断问题列表" ItemsSource="{Binding PlanWorkspace.FilteredFindings, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SelectedIssue, Mode=OneWay}" SelectionChanged="DiagnosticIssuesGrid_SelectionChanged" HeadersVisibility="None" BorderThickness="0">
                                    <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Summary, Mode=OneWay}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border x:Name="SeverityBadge" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="5,2"><TextBlock x:Name="SeverityLabel" Text="提示" Foreground="{DynamicResource InfoBrush}"/></Border>
                                                <TextBlock Text="{Binding Scope, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="Critical"><Setter TargetName="SeverityBadge" Property="Background" Value="{DynamicResource CriticalSurfaceBrush}"/><Setter TargetName="SeverityLabel" Property="Foreground" Value="{DynamicResource CriticalBrush}"/><Setter TargetName="SeverityLabel" Property="Text" Value="严重"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="Warning"><Setter TargetName="SeverityBadge" Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/><Setter TargetName="SeverityLabel" Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter TargetName="SeverityLabel" Property="Text" Value="警告"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding PlanWorkspace.FindingsEmptyMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="8" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PlanWorkspace.FilteredFindings.Count, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="索引">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MissingIndexes, Mode=OneWay}" Margin="8">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Table, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Schema, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="建议来源未说明；未提供收益估算"/><Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, Mode=OneWay}" Value="CapturedMissingIndex"><Setter Property="Text" Value="{Binding CapturedImpact, StringFormat='SQL Server 估算影响：{0:F2}%', TargetNullValue='SQL Server 缺失索引建议；未采集影响估算', Mode=OneWay}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Source, Mode=OneWay}" Value="SqlSyntax"><Setter Property="Text" Value="SQL 语法推导建议；未提供收益估算"/></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="{Binding Score, StringFormat='工具优先级评分：{0}/100', Mode=OneWay}" ToolTip="工具评分用于建议排序，不是实测性能收益" Margin="0,0,0,6"/>
                                            <Button Content="沙盒模拟" Command="{Binding DataContext.OpenSandboxCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" HorizontalAlignment="Left" Padding="8,2"/>
                                            <Expander Header="DDL、部署与回滚" Margin="0,8,0,0" IsExpanded="False">
                                                <StackPanel>
                                                    <TextBox Text="{Binding CreateIndexStatement, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
                                                    <WrapPanel Margin="0,4"><Button Content="复制 DDL" Click="CopyIndexDdl_Click" Tag="{Binding CreateIndexStatement, Mode=OneWay}" Padding="6,2" Margin="0,0,4,4"/><Button Content="复制部署包" Click="CopyDeploymentBundle_Click" Padding="6,2" Margin="0,0,0,4"/></WrapPanel>
                                                    <TextBox Text="{Binding RollbackStatement, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
                                                    <Button Content="复制回滚" Click="CopyRollbackDdl_Click" Tag="{Binding RollbackStatement, Mode=OneWay}" HorizontalAlignment="Left" Padding="6,2" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header><TextBlock Text="检查状态" Style="{StaticResource CheckFailureStatusText}"/></TabItem.Header>
                        <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBox x:Name="PlanWarningsTextBox" Text="{Binding PlanWorkspace.Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" BorderThickness="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding PlanWorkspace.CheckRuns, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SelectedIssue, Mode=OneWay}" SelectionChanged="DiagnosticIssuesGrid_SelectionChanged">
                                <DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding StatusLabel, Mode=OneWay}" Width="90"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn Header="检查与说明" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding RuleId, Mode=OneWay}"/><TextBlock Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Expander>
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" DragCompleted="PaneSplitter_DragCompleted"/>
            <TabControl x:Name="PlanGraphTabControl" Grid.Column="2" SelectionChanged="PlanGraphTabControl_SelectionChanged">
                <TabItem x:Name="GraphTab" Header="计划图" IsSelected="True"><local:PlanGraphControl x:Name="PlanNodifyGraph" NodeSelected="PlanNodifyGraph_NodeSelected" NodeDoubleClicked="PlanNodifyGraph_NodeDoubleClicked"/></TabItem>
                <TabItem x:Name="OperatorsTab" Header="热点算子">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="6"><Button DockPanel.Dock="Right" Content="显示列" Click="OperatorColumns_Click" Padding="8,2"/><TextBlock Text="按列排序定位热点；双击行查看节点。行数统一为每次执行口径。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel>
                        <DataGrid x:Name="RecostGrid" Grid.Row="1" ItemsSource="{Binding ElementName=PlanNodifyGraph, Path=AllNodes, Mode=OneWay}" MouseDoubleClick="RecostGrid_MouseDoubleClick" KeyDown="RecostGrid_KeyDown" CanUserReorderColumns="True" FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Node ID" Binding="{Binding NodeId, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn Header="物理操作" Binding="{Binding PhysicalOp, Mode=OneWay}" Width="155"/>
                                <DataGridTextColumn Header="对象" Binding="{Binding ObjectDisplay, Mode=OneWay}" Width="190"/>
                                <DataGridTextColumn Header="估算成本" Binding="{Binding EstimatedOperatorCost, Mode=OneWay}" SortMemberPath="OwnCost" Width="110"/>
                                <DataGridTextColumn Header="实际行 / 次" Binding="{Binding ComparableActualRowsDisplay, Mode=OneWay}" SortMemberPath="ComparableActualRows" Width="110"/>
                                <DataGridTextColumn Header="估算行 / 次" Binding="{Binding EstimatedRowsDisplay, Mode=OneWay}" SortMemberPath="EstRowsNum" Width="110"/>
                                <DataGridTextColumn Header="估算偏差" Binding="{Binding RowEstimateRatioDisplay, Mode=OneWay}" SortMemberPath="RowEstimateRatio" Width="105"/>
                                <DataGridTextColumn Header="读取放大" Binding="{Binding ReadAmplificationDisplay, Mode=OneWay}" SortMemberPath="ReadAmplification" Width="105" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="问题" Binding="{Binding DiagnosticCount, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn Header="工具重估成本" Binding="{Binding ActualRecost, StringFormat={}{0:G5}, Mode=OneWay}" Width="125" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="逻辑操作" Binding="{Binding LogicalOp, Mode=OneWay}" Width="155" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="执行模式" Binding="{Binding ExecutionMode, Mode=OneWay}" Width="160" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="并行" Binding="{Binding ParallelDisplay, Mode=OneWay}" Width="100" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="有序扫描" Binding="{Binding Ordered, Mode=OneWay}" Width="100" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="实际输出总行数" Binding="{Binding ActualRows, TargetNullValue=未采集, Mode=OneWay}" Width="150" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="实际读取总行数" Binding="{Binding ActualRowsRead, TargetNullValue=未采集, Mode=OneWay}" Width="150" Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" DragCompleted="PaneSplitter_DragCompleted"/>
            <Expander x:Name="RightPanel" Grid.Column="4" Style="{StaticResource WorkspacePane}" IsExpanded="True" AutomationProperties.Name="算子与诊断详情侧栏" Expanded="RightPanel_Expanded" Collapsed="RightPanel_Collapsed">
                <TabControl x:Name="DetailsTabs">
                    <TabItem x:Name="StructuredDetailsTab" Header="详情">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,6,12,12">
                                <TextBlock Text="{Binding PlanWorkspace.DetailTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PlanWorkspace.DetailSubtitle, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,6"/>
                                <TextBlock Text="指标与证据" Style="{StaticResource DetailHeading}"/>
                                <ItemsControl ItemsSource="{Binding PlanWorkspace.DetailFacts, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="原因" Style="{StaticResource DetailHeading}"/><TextBlock Text="{Binding PlanWorkspace.DetailReasons, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Text="建议" Style="{StaticResource DetailHeading}"/><TextBlock Text="{Binding PlanWorkspace.DetailRecommendations, Mode=OneWay}" TextWrapping="Wrap"/>
                                <StackPanel Visibility="{Binding PlanWorkspace.HasDetailLimitations, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"><TextBlock Text="适用条件与限制" Style="{StaticResource DetailHeading}"/><TextBlock Text="{Binding PlanWorkspace.DetailLimitations, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel>
                                <TextBlock Text="原始证据" Style="{StaticResource DetailHeading}"/>
                                <ComboBox x:Name="DiagnosticEvidenceSelector" AutomationProperties.Name="诊断证据" ItemsSource="{Binding PlanWorkspace.Evidence, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SelectedEvidence, Mode=TwoWay}" DisplayMemberPath="Name" ToolTip="选择证据以定位对应语句和节点"/>
                                <TextBlock Text="证据值" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,3"/>
                                <TextBox x:Name="SelectedEvidenceValue" AutomationProperties.Name="选中证据值" Text="{Binding PlanWorkspace.SelectedEvidence.Value, Mode=OneWay, TargetNullValue=未采集, FallbackValue=未采集}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="96" VerticalScrollBarVisibility="Auto"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="状态" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                                    <TextBlock x:Name="SelectedEvidenceState" Grid.Column="1" AutomationProperties.Name="选中证据状态" Text="{Binding PlanWorkspace.SelectedEvidence.State, TargetNullValue=未选择证据, FallbackValue=未选择证据, Mode=OneWay}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="来源" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="SelectedEvidenceSource" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="选中证据来源" Text="{Binding PlanWorkspace.SelectedEvidence.Source, TargetNullValue=未采集, FallbackValue=未采集, Mode=OneWay}" TextWrapping="Wrap"/>
                                </Grid>
                                <Button Content="查看原始 SQL / XML" Click="ShowEvidenceSource_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                <TextBlock Text="{Binding PlanWorkspace.RelatedFindingsSummary, Mode=OneWay}" Style="{StaticResource DetailHeading}" TextWrapping="Wrap"/>
                                <ListBox SelectionChanged="DiagnosticIssuesGrid_SelectionChanged" ItemsSource="{Binding PlanWorkspace.RelatedFindings, Mode=OneWay}" SelectedItem="{Binding PlanWorkspace.SelectedIssue, Mode=OneWay}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap" Margin="2,4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="AllPropertiesTab" Header="全部属性">
                        <DataGrid x:Name="PlanPropertiesGrid" GridLinesVisibility="Horizontal">
                            <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Expander.Header><TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4"/></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
                            <DataGrid.Columns><DataGridTextColumn Header="属性" Binding="{Binding Name, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="值" Binding="{Binding Value, Mode=OneWay}" Width="1.5*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Expander>
        </Grid>
        <Expander x:Name="AuxiliaryPanel" Grid.Row="2" Style="{StaticResource CompactAuxiliaryPane}" IsExpanded="False" Header="SQL · XML · 参数统计 · 改写提案" Expanded="AuxiliaryPanel_Changed" Collapsed="AuxiliaryPanel_Changed">
            <Grid x:Name="AuxiliaryContent" Height="220">
                <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Thumb x:Name="AuxiliaryResizeThumb" Grid.Row="0" Cursor="SizeNS" DragDelta="AuxiliaryResizeThumb_DragDelta" ToolTip="拖动调整辅助面板高度"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource BorderBrush}"/></ControlTemplate></Thumb.Template></Thumb>
                <TabControl x:Name="AuxiliaryTabs" Grid.Row="1">
                    <TabItem x:Name="StatementSourceTab" Header="SQL"><TextBox x:Name="PlanStatementTextBox" Text="{Binding PlanStatementText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem x:Name="XmlSourceTab" Header="XML"><TextBox x:Name="PlanXmlTextBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem x:Name="EvidenceSourceTab" Header="证据原始位置">
                        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/><RowDefinition Height="1.3*"/></Grid.RowDefinitions>
                            <TextBox x:Name="EvidenceSourceDetails" AutomationProperties.Name="完整证据与来源说明" Text="{Binding PlanWorkspace.SourceDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TabIndex="0"/>
                            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="SQL" Margin="0,2"/>
                                    <TextBox x:Name="EvidenceSql" AutomationProperties.Name="证据 SQL" Grid.Row="1" Text="{Binding PlanWorkspace.SourceTarget.Sql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TabIndex="1"/>
                                </Grid>
                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="XML" Margin="0,2"/>
                                    <TextBox x:Name="EvidenceXml" AutomationProperties.Name="证据 XML" Grid.Row="1" Text="{Binding PlanWorkspace.SourceTarget.Xml, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TabIndex="2"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="StatisticsTab" Header="参数统计"><local:StatisticsHistogramControl x:Name="StatisticsHistogramView"/></TabItem>
                    <TabItem x:Name="SqlRefactorTab" Header="SQL 改写提案" Margin="0,0,3,0">
                                    <Grid Background="{DynamicResource MaterialDesignPaper}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
    <StackPanel>
        <TextBlock Text="查看改写前提、风险与 SQL diff；选择仅生成审核预览" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <WrapPanel>
            <Button Content="审核提案" Click="ReviewProposals_Click" Margin="0,0,8,4" Padding="10,2"/>
            <Button Content="复制当前预览" Click="CopyRefactoredSql_Click" Margin="0,0,8,4" Padding="10,2"/>
            <Button Content="隐藏原始 SQL" x:Name="BtnCompareSql" Click="CompareSql_Click" Margin="0,0,0,4" Padding="10,2"/>
        </WrapPanel>
    </StackPanel>
</Border>
<!-- Side-by-Side SQL view -->
                                        <Grid Grid.Row="1" Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" x:Name="OriginalSqlCol"/>
                                                <ColumnDefinition Width="4" x:Name="SqlSplitterCol"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Original SQL -->
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource SurfaceBrush}" Padding="4,2" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                    <TextBlock Text="原始 SQL 语句" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center"/>
                                                </Border>
                                                <RichTextBox Grid.Row="1" x:Name="OriginalSqlTextBox" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="6" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                                    <RichTextBox.Resources>
                                                        <Style TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Margin" Value="0"/>
                                                        </Style>
                                                    </RichTextBox.Resources>
                                                </RichTextBox>
                                            </Grid>
                                            
                                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" x:Name="SqlGridSplitter"/>
                                            
                                            <!-- Refactored SQL -->
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource SurfaceBrush}" Padding="4,2" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource BorderBrush}">
                                                    <TextBlock Text="审核预览（未选择时保留原文）" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" FontSize="13" HorizontalAlignment="Center"/>
                                                </Border>
                                                <RichTextBox Grid.Row="1" x:Name="RefactoredSqlTextBox" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="6" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <RichTextBox.Resources>
                                                        <Style TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Margin" Value="0"/>
                                                        </Style>
                                                    </RichTextBox.Resources>
                                                </RichTextBox>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                    <TabItem Header="改写状态"><TextBox x:Name="RefactoringNoticesTextBox" Text="{Binding PlanWorkspace.RefactoringNotices, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem Header="高级结构">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TreeView x:Name="PlanOperatorTree" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectedItemChanged="PlanOperatorTree_SelectedItemChanged"/>
                            <TreeView x:Name="PlanVisualTree" Grid.Column="1" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemTemplate="{StaticResource PlanOperatorTemplate}" SelectedItemChanged="PlanVisualTree_SelectedItemChanged"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
