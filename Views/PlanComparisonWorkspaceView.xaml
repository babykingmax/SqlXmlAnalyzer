<UserControl x:Class="SqlXmlAnalyzer.Views.PlanComparisonWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:evidence="clr-namespace:SqlXmlAnalyzer.Core.Services;assembly=SqlXmlAnalyzer.Core">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
<Grid Background="{DynamicResource MaterialDesignPaper}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="200"/>
                        <!-- 调优历史列表 -->
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <!-- 并排对比控制板 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：调优历史 (Tuning History) -->
                    <Grid Grid.Column="0" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <TextBlock Text="调优版本历史 (Tuning History)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,2">
                                <Button Content="📸 捕获当前计划" Command="{Binding CaptureCurrentPlanCommand}" Height="28" Margin="0,0,4,0" ToolTip="将当前查看的执行计划加入调优历史列表中"/>
                                <Button Content="🧹 清空历史" Command="{Binding ClearHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="28" Margin="4,0,0,0"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button x:Name="SetSelectedPlanA" Content="设为 A（基准）" Command="{Binding SetAsPlanACommand}" CommandParameter="{Binding SelectedItem, ElementName=TuningHistoryListView}" Margin="0,0,4,0" Height="30"/>
                                <Button x:Name="SetSelectedPlanB" Content="设为 B（待比较）" Command="{Binding SetAsPlanBCommand}" CommandParameter="{Binding SelectedItem, ElementName=TuningHistoryListView}" Margin="4,0,0,0" Height="30"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 历史快照列表 -->
                        <ListView Grid.Row="1" ItemsSource="{Binding TuningHistory}" x:Name="TuningHistoryListView" MouseDoubleClick="TuningHistoryListView_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2" ToolTip="右键设置计划A/B对比，或双击载入主视图">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#37474F"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Cost: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding TotalCost, TargetNullValue=N/A, StringFormat={}{0:F4}}" FontWeight="Bold" Foreground="#0078D7" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="Ops: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding OperatorCount}" Foreground="#37474F" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="Idx: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding MissingIndexCount}" Foreground="#EF6C00" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{Binding ShortStatementText}" Foreground="#546E7A" FontSize="10" FontStyle="Italic"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="设为 [计划 A] (基准)" Command="{Binding PlacementTarget.Tag.SetAsPlanACommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="设为 [计划 B] (待比较)" Command="{Binding PlacementTarget.Tag.SetAsPlanBCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="删除快照" Command="{Binding PlacementTarget.Tag.RemoveSnapshotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- 会话保存与加载 -->
                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="💾 保存会话 (.pesession)" Click="SaveSession_Click" Height="30" Margin="0,0,4,0" ToolTip="保存当前所有的调优历史记录及计划文档到会话文件"/>
                                <Button Content="📂 加载会话" Click="LoadSession_Click" Style="{StaticResource SecondaryButtonStyle}" Height="30" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" />

                    <!-- 右侧：对比区域 -->
                    <Grid Grid.Column="2" Margin="6">
                        <!-- 未设置对比计划时的占位信息 -->
                        <Grid Visibility="{Binding CompareVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate, FallbackValue=Visible}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚖️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="选中左侧快照，点击『设为 A』或『设为 B』进行比较。"
                                           Foreground="#78909C" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="提示：可以右键选中快照并设为计划 A/B；双击快照可以将其重新载入主窗口进行详细诊断。" 
                                           Foreground="#B0BEC5" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>

                        <!-- A/B 并排对比核心面板 -->
                        <Grid Visibility="{Binding CompareVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- 顶部对比卡片 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 查询语句对比 -->
                                <RowDefinition Height="*"/>
                                <!-- 树状差异并排 -->
                            </Grid.RowDefinitions>

                            <!-- 顶部对比卡片 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 计划 A 卡片 (基准) -->
                                <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#0078D7" BorderThickness="2,1,1,1" CornerRadius="4" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="[计划 A] (基准)" FontSize="11" Foreground="#0078D7" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PlanA.Title}" FontSize="13" FontWeight="Bold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="总估算成本" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanA.TotalCost, TargetNullValue=N/A, StringFormat={}{0:F4}}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="算子数量" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanA.OperatorCount}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="缺失索引" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanA.MissingIndexCount}" FontSize="16" FontWeight="Bold" Foreground="#EF6C00"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 差异分析中心指示卡 -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="8,4" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="估算成本变化" FontSize="10" Foreground="#78909C" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CostDeltaText}" FontSize="13" FontWeight="Bold" Foreground="{Binding CostDeltaColor}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4"/>
                                        <Button Content=" 🔁 交换 A/B " Click="SwapPlanAB_Click" FontSize="10" Padding="8,2" Height="22" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ComparisonEvidenceNotice" Text="{x:Static evidence:AnalysisDisplayText.ComparisonNotice}"
                                                   Foreground="#795548" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 计划 B 卡片 (待比较) -->
                                <Border Grid.Column="2" Background="#F5F7FA" BorderBrush="#2E7D32" BorderThickness="2,1,1,1" CornerRadius="4" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="[计划 B] (待比较)" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PlanB.Title}" FontSize="13" FontWeight="Bold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="总估算成本" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanB.TotalCost, TargetNullValue=N/A, StringFormat={}{0:F4}}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="算子数量" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanB.OperatorCount}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="缺失索引" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanB.MissingIndexCount}" FontSize="16" FontWeight="Bold" Foreground="#EF6C00"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="4,0,4,8">
                            <StackPanel>
                                <TextBlock x:Name="ComparisonMatchSummary" Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="人工选择 A 的语句" Foreground="{DynamicResource MaterialDesignBody}"/><ComboBox x:Name="ComparisonScopeA" ItemsSource="{Binding ComparisonScopesA}" SelectedItem="{Binding ManualScopeA}" DisplayMemberPath="Label" ToolTip="人工选择计划 A 的语句/QueryPlan" MaxDropDownHeight="220"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,4,0"><TextBlock Text="人工选择 B 的语句" Foreground="{DynamicResource MaterialDesignBody}"/><ComboBox x:Name="ComparisonScopeB" ItemsSource="{Binding ComparisonScopesB}" SelectedItem="{Binding ManualScopeB}" DisplayMemberPath="Label" ToolTip="人工选择计划 B 的语句/QueryPlan" MaxDropDownHeight="220"/></StackPanel>
                                    <Button Grid.Column="2" Content="比较所选" Command="{Binding ApplyComparisonSelectionCommand}" Margin="0,0,4,0" ToolTip="人工配对不覆盖采集条件检查"/>
                                    <Button Grid.Column="3" Content="全部语句" Command="{Binding ResetComparisonSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                                <Expander Header="匹配依据与可比性" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ComparisonConditionsText" Text="{Binding ComparisonConditions}" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Normal"/></ScrollViewer>
                                </Expander>
                                <Expander x:Name="UnmatchedPlans" Header="未匹配语句 / QueryPlan 清单" Margin="0,4,0,0">
                                    <Grid Height="110">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="UnmatchedPlanA" Text="{Binding ComparisonUnmatchedA, Mode=OneWay}" IsReadOnly="True" FontWeight="Normal" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="A 未匹配项"/>
                                        <TextBox x:Name="UnmatchedPlanB" Grid.Column="2" Text="{Binding ComparisonUnmatchedB, Mode=OneWay}" IsReadOnly="True" FontWeight="Normal" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="B 未匹配项"/>
                                    </Grid>
                                </Expander>
                            <!-- 查询语句对比 -->
                            <Expander Header="查询语句对比 (SQL Statements)" ExpandDirection="Down" IsExpanded="False" Margin="0,4,0,0">

    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="50" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding PlanA.StatementText}" FontFamily="Consolas" FontSize="10" Background="{DynamicResource MaterialDesignPaper}" VerticalScrollBarVisibility="Auto"/>
                                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
                                    <TextBox Grid.Column="2" Height="50" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding PlanB.StatementText}" FontFamily="Consolas" FontSize="10" Background="{DynamicResource MaterialDesignPaper}" VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Expander>
                            </StackPanel>
                            </ScrollViewer>

                            <!-- 树状差异并排 -->
                            <Grid Grid.Row="2" Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 计划 A 的 TreeView -->
                                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">

    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#F5F7FA" Padding="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="计划 A 操作符结构树" FontWeight="SemiBold" FontSize="11" Foreground="#546E7A"/>
                                        </Border>
                                        <TreeView Grid.Row="1" x:Name="PlanATreeView" BorderThickness="0"/>
                                    </Grid>
                                </Border>

                                <!-- 计划 B 的 TreeView -->
                                <Border Grid.Column="2" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">

    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#F5F7FA" Padding="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="计划 B 操作符结构树" FontWeight="SemiBold" FontSize="11" Foreground="#546E7A"/>
                                        </Border>
                                        <TreeView Grid.Row="1" x:Name="PlanBTreeView" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
</UserControl>
