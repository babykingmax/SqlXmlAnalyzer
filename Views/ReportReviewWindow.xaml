<Window x:Class="SqlXmlAnalyzer.Views.ReportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报告范围与脱敏预览" Width="1180" Height="820" MinWidth="850" MinHeight="620" FontWeight="Normal" WindowStartupLocation="CenterOwner">
    <!-- Keep star rows finite when the accessibility wrapper measures scrollable content. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="16" Width="1080" Height="700">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="报告范围与脱敏预览" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="ReportScope" Text="{Binding Scope}" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Counts}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,6"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <DockPanel Margin="0,5">
                <ComboBox x:Name="ReportFormat" DockPanel.Dock="Right" Width="140" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="报告格式"/>
                <CheckBox x:Name="RedactReport" Content="使用脱敏快照（取消勾选将导出未脱敏内容）" IsChecked="{Binding IsRedacted}" IsEnabled="{Binding CanEdit}"/>
            </DockPanel>
            <TextBlock Text="{Binding FormatNotice}" TextWrapping="Wrap" Margin="0,4,0,8"/>
        </StackPanel>
        <TabControl x:Name="PreviewTabs" Grid.Row="2">
            <TabItem Header="当前报告预览"><TextBox x:Name="ReportPreview" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="8"/></TabItem>
            <TabItem Header="脱敏范围和样例">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Redaction.Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <GroupBox Header="已处理类别与数量"><DataGrid ItemsSource="{Binding Redaction.Counts}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="数量" Binding="{Binding Value}" Width="80"/></DataGrid.Columns></DataGrid></GroupBox>
                        <GroupBox Grid.Column="1" Header="未覆盖项（非零则阻止脱敏导出）"><DataGrid ItemsSource="{Binding Redaction.Unsupported}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="数量" Binding="{Binding Value}" Width="80"/></DataGrid.Columns></DataGrid></GroupBox>
                    </Grid>
                    <DataGrid x:Name="RedactionSamples" Grid.Row="2" ItemsSource="{Binding Redaction.Samples}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="150"/>
                            <DataGridTemplateColumn Header="处理前（仅本地预览，不随脱敏报告导出）" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Before}" TextWrapping="Wrap" Margin="6" FontWeight="Normal"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="处理后" Width="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding After}" TextWrapping="Wrap" Margin="6" FontWeight="Normal"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="SaveReport" DockPanel.Dock="Right" Content="保存为新文件" Click="Save_Click" IsEnabled="{Binding CanExport}" Padding="15,6" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="取消导出 / 关闭" Click="Cancel_Click" Padding="12,6"/>
            <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="80" BorderThickness="0" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>
