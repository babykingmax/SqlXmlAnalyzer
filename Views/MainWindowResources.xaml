<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SqlXmlAnalyzer.Converters">
    <conv:ScoreToColorConverter x:Key="ScoreColorConv"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    <HierarchicalDataTemplate x:Key="PlanOperatorTemplate"
                              ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal"
                    Margin="2">
            <Image Source="{Binding OperatorIcon}"
                   Width="16"
                   Height="16"
                   Margin="0,0,4,0"
                   VerticalAlignment="Center"
                   SnapsToDevicePixels="True"/>
            <TextBlock Text="{Binding PhysicalOp}"
                       FontWeight="SemiBold"
                       Foreground="{Binding CostColor}"/>
            <TextBlock Text=" ("
                       Foreground="Gray"/>
            <TextBlock Text="{Binding LogicalOp}"
                       Foreground="Gray"/>
            <TextBlock Text=")"
                       Foreground="Gray"/>
            <TextBlock Text="  Cost: "
                       Foreground="#666"/>
            <TextBlock Text="{Binding Cost, StringFormat={}{0:F2}}"
                       Foreground="{Binding CostColor}"/>
            <TextBlock Text="  Rows: "
                       Foreground="#666"/>
            <TextBlock Text="{Binding EstRows}"
                       Foreground="#666"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="DeadlockRelationTemplate"
                              ItemsSource="{Binding Waiters}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Resource "/>
            <TextBlock Text="{Binding ResourceName}"
                       FontWeight="SemiBold"/>
            <TextBlock Text=" held by "/>
            <TextBlock Text="{Binding Holder}"
                       Foreground="#0066CC"/>
            <TextBlock Text=", waiters: "/>
            <TextBlock Text="{Binding WaiterCount}"
                       Foreground="Red"/>
        </StackPanel>
    </HierarchicalDataTemplate>
</ResourceDictionary>
