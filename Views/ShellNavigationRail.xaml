<UserControl x:Class="SqlXmlAnalyzer.Views.ShellNavigationRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:SqlXmlAnalyzer.Core.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Background="{DynamicResource MaterialDesignCardBackground}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0,0,1,0"
            Padding="0,12,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>

            <StackPanel>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.OpenDeadlock}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="打开死锁文件 (XML / XDL / XEL)  ·  Ctrl+Shift+O"
                        AutomationProperties.Name="打开死锁文件"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="LockAlert"
                                             Width="24"
                                             Height="24"
                                             Foreground="{DynamicResource AccentBrush}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.OpenPlan}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="打开执行计划 (.sqlplan)  ·  Ctrl+O"
                        AutomationProperties.Name="打开执行计划"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="ChartTree"
                                             Width="24"
                                             Height="24"
                                             Foreground="{DynamicResource AccentBrush}"/>
                </Button>
                <Separator Background="{DynamicResource MaterialDesignDivider}"
                           Margin="12,0,12,16"/>

                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.ExportHtml}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="导出 HTML 报告  ·  Ctrl+R"
                        AutomationProperties.Name="导出 HTML 报告"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="LanguageHtml5"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.ExportWord}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="导出 Word 报告"
                        AutomationProperties.Name="导出 Word 报告"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="FileWordOutline"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.ExportPdf}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="导出 PDF 报告"
                        AutomationProperties.Name="导出 PDF 报告"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="FilePdfBox"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.ExportPlan}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="导出脱敏执行计划"
                        AutomationProperties.Name="导出脱敏执行计划"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Incognito"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
            </StackPanel>

            <StackPanel>
                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{x:Static commands:WorkspaceCommands.Configuration}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="规则配置" AutomationProperties.Name="规则配置" Width="48" Height="48" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22" Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{x:Static commands:WorkspaceCommands.DiagnosticPackage}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="本地诊断数据包（预览并选择内容）" AutomationProperties.Name="本地诊断数据包" Width="48" Height="48" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="22" Height="22" Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.CopyResults}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="复制分析结果  ·  Ctrl+Shift+C"
                        AutomationProperties.Name="复制分析结果"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="ContentCopy"
                                             Width="20"
                                             Height="20"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.Clear}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="清空所有结果  ·  Ctrl+L"
                        AutomationProperties.Name="清空所有结果"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Broom"
                                             Width="20"
                                             Height="20"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Separator Background="{DynamicResource MaterialDesignDivider}"
                           Margin="12,0,12,16"/>
                <Button Content="⌨" Width="48" Height="40" Command="{x:Static commands:WorkspaceCommands.Help}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="快捷键与显示选项 · Ctrl+F1" AutomationProperties.Name="快捷键与显示选项"/>
                <ToggleButton x:Name="ThemeToggle"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              Click="OnThemeToggleClick"
                              ToolTip="切换深色 / 浅色主题"
                              AutomationProperties.Name="切换深色或浅色主题"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16"/>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{x:Static commands:WorkspaceCommands.About}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="关于 SqlXmlAnalyzer  ·  F1"
                        AutomationProperties.Name="关于"
                        Width="48"
                        Height="48">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
            </StackPanel>
        </StackPanel></ScrollViewer>
    </Border>
</UserControl>
