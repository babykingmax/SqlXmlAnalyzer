<UserControl x:Class="SqlXmlAnalyzer.Views.ShellNavigationRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Background="{DynamicResource MaterialDesignCardBackground}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0,0,1,0"
            Padding="0,12,0,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnOpenDeadlockClick"
                        ToolTip="Open deadlock XML/XDL/XEL"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="LockAlert"
                                             Width="24"
                                             Height="24"
                                             Foreground="{DynamicResource MaterialDesignPrimaryBrush}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnOpenPlanClick"
                        ToolTip="Open execution plan"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="ChartTree"
                                             Width="24"
                                             Height="24"
                                             Foreground="{DynamicResource MaterialDesignPrimaryBrush}"/>
                </Button>
                <Separator Background="{DynamicResource MaterialDesignDivider}"
                           Margin="12,0,12,16"/>

                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnGenerateHtmlReportClick"
                        ToolTip="Export HTML report"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="LanguageHtml5"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnExportWordClick"
                        ToolTip="Export Word report"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="FileWordOutline"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnExportPdfClick"
                        ToolTip="Export PDF report"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="FilePdfBox"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnExportObfuscatedPlanClick"
                        ToolTip="Export obfuscated execution plan"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Incognito"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnCopyAnalysisResultClick"
                        ToolTip="Copy analysis result"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="ContentCopy"
                                             Width="20"
                                             Height="20"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnClearResultsClick"
                        ToolTip="Clear all results"
                        Width="48"
                        Height="48"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Broom"
                                             Width="20"
                                             Height="20"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
                <Separator Background="{DynamicResource MaterialDesignDivider}"
                           Margin="12,0,12,16"/>
                <ToggleButton x:Name="ThemeToggle"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              Click="OnThemeToggleClick"
                              ToolTip="Toggle dark theme"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16"/>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Click="OnAboutClick"
                        ToolTip="About"
                        Width="48"
                        Height="48">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
