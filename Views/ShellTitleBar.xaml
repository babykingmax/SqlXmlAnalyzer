<UserControl x:Class="SqlXmlAnalyzer.Views.ShellTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:ColorZone Mode="PrimaryMid"
                              Padding="12,0"
                              Background="{DynamicResource MaterialDesignPaper}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="DatabaseSearchOutline"
                                         Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignPrimaryBrush}"/>
                <TextBlock Text="SqlXmlAnalyzer"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="OnMinimizeClick"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="46"
                        Height="32"
                        Padding="0"
                        Content="-"
                        Foreground="{DynamicResource MaterialDesignBody}"/>
                <Button Click="OnMaximizeClick"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="46"
                        Height="32"
                        Padding="0"
                        Content="[]"
                        Foreground="{DynamicResource MaterialDesignBody}"/>
                <Button Click="OnCloseClick"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="46"
                        Height="32"
                        Padding="0"
                        Content="X"
                        Foreground="{DynamicResource MaterialDesignBody}"/>
            </StackPanel>
        </Grid>
    </materialDesign:ColorZone>
</UserControl>
