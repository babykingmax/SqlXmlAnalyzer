<Window x:Class="SqlXmlAnalyzer.Views.IndexSandboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SqlXmlAnalyzer.Converters"
        Title="索引沙盒模拟 (Index Sandbox)" Height="580" Width="920"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8" FontFamily="Segoe UI">
    <Window.Resources>
        <conv:ScoreToColorConverter x:Key="ScoreColorConv"/>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Table, StringFormat='表索引沙盒分析: {0}'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#263238"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 可用表列 -->
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <!-- 选定索引列 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <!-- 评分与Tipping Point分析 -->
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 1. 可用表列 (Available Columns) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="可用表列 (Available Columns)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#37474F" FontSize="12"/>
                <Border Grid.Row="1" Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <ListBox ItemsSource="{Binding AvailableColumns}" BorderThickness="0" Background="Transparent" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#37474F" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                        <Button Content="+ 键" FontSize="9.5" Padding="4,2" Margin="2,0" Background="#ECEFF1" BorderBrush="#B0BEC5" Cursor="Hand"
                                                Command="{Binding DataContext.AddKeyColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="+ 包" FontSize="9.5" Padding="4,2" Margin="2,0" Background="#ECEFF1" BorderBrush="#B0BEC5" Cursor="Hand"
                                                Command="{Binding DataContext.AddIncludeColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- 2. 选定索引列 (Key & Include Columns) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="键列 (Key Columns) - 顺序敏感" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#37474F" FontSize="12"/>
                <Border Grid.Row="1" Margin="0,0,0,12" Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <ListBox ItemsSource="{Binding KeyColumns}" BorderThickness="0" Background="Transparent" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#263238"/>
                                        <TextBlock Text="{Binding Usage, StringFormat=' ({0})'}" Foreground="#78909C" FontSize="10" Margin="6,0,0,0" FontStyle="Italic"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Content="↑" FontSize="9.5" Padding="5,1" Command="{Binding DataContext.MoveKeyColumnUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0" Cursor="Hand"/>
                                        <Button Content="↓" FontSize="9.5" Padding="5,1" Command="{Binding DataContext.MoveKeyColumnDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0" Cursor="Hand"/>
                                        <Button Content="删除" FontSize="9.5" Padding="5,1" Command="{Binding DataContext.RemoveKeyColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#C62828" Margin="2,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="2" Text="包含列 (Include Columns)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#37474F" FontSize="12"/>
                <Border Grid.Row="3" Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <ListBox ItemsSource="{Binding IncludeColumns}" BorderThickness="0" Background="Transparent" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" Foreground="#263238"/>
                                    <Button Grid.Column="1" Content="删除" FontSize="9.5" Padding="5,1" Command="{Binding DataContext.RemoveIncludeColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#C62828" Margin="2,0" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- 3. 评分与 Tipping Point 分析 -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 评分板 -->
                    <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="索引契合评分" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#37474F"/>
                            <Separator Background="#ECEFF1" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CurrentScore, StringFormat={}{0} / 100}" 
                                       Foreground="{Binding CurrentScore, Converter={StaticResource ScoreColorConv}}" 
                                       FontWeight="Bold" FontSize="44" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 成本模拟板 -->
                    <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="成本影响模拟" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#37474F"/>
                            <Separator Background="#ECEFF1" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding CostReductionDescription}">
                                <TextBlock Text="预估总成本降低: " FontSize="12" VerticalAlignment="Center" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding EstimatedCostReductionPercent, StringFormat={}{0}%}" Foreground="#2E7D32" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▲" Foreground="#2E7D32" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CostReductionDescription}" Foreground="#78909C" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Tipping Point 临界线展示板 -->
                    <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="回表临界值分析 (Tipping Point)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#37474F"/>
                            <Separator Background="#ECEFF1" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表估算总行数:" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding TotalRows, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="20" FontSize="11" Padding="2,0" VerticalContentAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="平均行宽 (Bytes):" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding AvgRowSize, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="20" FontSize="11" Padding="2,0" VerticalContentAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="查询预计返回行数:" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ReturnedRows, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="20" FontSize="11" Padding="2,0" VerticalContentAlignment="Center"/>
                            </Grid>
                            
                            <Separator Background="#ECEFF1" Margin="0,8"/>
                            
                            <TextBlock Text="{Binding TippingPointStatus}" Foreground="{Binding TippingPointStatusColor}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TippingPointDetails}" Foreground="#546E7A" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部：脚本与操作 -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="生成的 CREATE INDEX 脚本:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#37474F" FontSize="12"/>
            <TextBox Text="{Binding CreateIndexStatement}" IsReadOnly="True" Height="60" TextWrapping="Wrap" Background="#ECEFF1" FontFamily="Consolas" FontSize="11.5" Padding="6" BorderBrush="#CFD8DC"/>
            <Button Content="复制脚本并关闭" Click="CopyAndClose_Click" Width="150" Height="32" Background="#0078D7" Foreground="White" BorderThickness="0" Margin="0,12,0,0" HorizontalAlignment="Right" Cursor="Hand" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
