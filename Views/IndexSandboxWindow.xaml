<Window x:Class="SqlXmlAnalyzer.Views.IndexSandboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SqlXmlAnalyzer.Converters"
        Title="索引沙盒模拟 (Index Sandbox)" Height="500" Width="800"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8" FontFamily="Segoe UI">
    <Window.Resources>
        <conv:ScoreToColorConverter x:Key="ScoreColorConv"/>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Table, StringFormat='表: {0}'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：列编辑区 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="键列 (Key Columns)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding KeyColumns}" Margin="0,0,0,8" x:Name="KeyColsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Usage, StringFormat=' ({0})'}" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="↑" Width="20" Command="{Binding DataContext.MoveKeyColumnUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                    <Button Content="↓" Width="20" Command="{Binding DataContext.MoveKeyColumnDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                    <Button Content="X" Width="20" Command="{Binding DataContext.RemoveKeyColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="Red" Margin="2,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Text="包含列 (Include Columns)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding IncludeColumns}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="X" Width="20" Command="{Binding DataContext.RemoveIncludeColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="Red" Margin="2,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 右侧：评分与模拟 -->
            <StackPanel Grid.Column="2">
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="实时评分" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentScore, StringFormat={}{0} / 100}" 
                                   Foreground="{Binding CurrentScore, Converter={StaticResource ScoreColorConv}}" 
                                   FontWeight="Bold" FontSize="48" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="成本影响模拟" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <Separator Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding CostReductionDescription}">
                            <TextBlock Text="预估总成本降低: " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EstimatedCostReductionPercent, StringFormat={}{0}%}" Foreground="Green" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text=" ▲" Foreground="Green" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CostReductionDescription}" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 底部：脚本与操作 -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="生成的 CREATE INDEX 脚本:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CreateIndexStatement}" IsReadOnly="True" Height="60" TextWrapping="Wrap" Background="#F1F1F1" FontFamily="Consolas" Padding="4"/>
            <Button Content="复制脚本并关闭" Click="CopyAndClose_Click" Width="150" Height="32" Background="#0078D7" Foreground="White" BorderThickness="0" Margin="0,12,0,0" HorizontalAlignment="Right" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
