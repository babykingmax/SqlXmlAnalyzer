<Window x:Class="SqlXmlAnalyzer.Views.DiagnosticPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地诊断数据包 · 内容审核" Width="1080" Height="800" MinWidth="780" MinHeight="600"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BackgroundBrush}"
        FontWeight="Normal" WindowStartupLocation="CenterOwner">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="16" Width="1000" Height="700">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="本地诊断数据包" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Margin="0,6"/>
            <TextBox Text="{Binding SourceNotice, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="55" VerticalScrollBarVisibility="Auto" BorderThickness="0">
                <TextBox.Style><Style TargetType="TextBox"><Style.Triggers><DataTrigger Binding="{Binding SourceNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
            </TextBox>
            <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>
        <StackPanel Grid.Row="1" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="固定内容：版本与采集条件、有效规则配置、错误摘要、缺失证据、清单和校验信息。" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8">
                <CheckBox Content="附带脱敏报告" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IncludeReport}" IsEnabled="{Binding HasReport}" Margin="0,0,20,0"/>
                <CheckBox Content="附带原始选中 XML（未脱敏）" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IncludeRawSelection}" IsEnabled="{Binding HasReport}"/>
            </WrapPanel>
            <DockPanel Margin="0,0,0,6">
                <Button Content="选择日志（未脱敏）" Click="SelectLog_Click" Padding="10,4"/>
                <Button Content="移除日志" Click="RemoveLog_Click" Padding="10,4" Margin="6,0"/>
                <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="所选本地日志路径" ToolTip="最多 2 MiB UTF-8 文本；原路径不进入数据包"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <Button Content="选择 DUMP（未脱敏）" Click="SelectDump_Click" Padding="10,4"/>
                <Button Content="移除 DUMP" Click="RemoveDump_Click" Padding="10,4" Margin="6,0"/>
                <TextBox Text="{Binding DumpPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="所选本地 DUMP 路径" ToolTip="最多 64 MiB；只展示大小和 SHA-256，不能证明内存内容可公开"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,10">
                <Button x:Name="PreparePackage" Content="生成 / 更新预览" Click="Prepare_Click" Padding="14,5" DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding InventorySummary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DataGrid x:Name="PackageFiles" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="诊断包实际文件清单">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Padding" Value="12,6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                        </Trigger></Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="包内文件" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="90"/>
                    <DataGridTextColumn Header="脱敏状态" Binding="{Binding PrivacyLabel}" Width="160"/>
                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="*" MinWidth="200"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
            <TextBox x:Name="PackagePreview" Grid.Row="2" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Padding="8" AutomationProperties.Name="所选文件实际内容预览"/>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="SavePackage" Content="保存审核快照为 ZIP" Click="Save_Click" IsEnabled="{Binding CanSave}" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0"/>
            <Button Content="取消 / 关闭" Click="Close_Click" DockPanel.Dock="Right" Padding="12,6"/>
            <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="80" BorderThickness="0" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>
