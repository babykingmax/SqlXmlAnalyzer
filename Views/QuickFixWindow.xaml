<Window x:Class="SqlXmlAnalyzer.QuickFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SQL 快速修复与效果对比" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Border Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- TitleBar -->
                <RowDefinition Height="*"/>  <!-- Code Views -->
                <RowDefinition Height="60"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- Custom TitleBar -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="12,0" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource MaterialDesignBody}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="18" Height="18" VerticalAlignment="Center" Foreground="#FFD700"/>
                        <TextBlock Text="SQL 快速修复与效果对比 (SQL Quick Fix &amp; Comparison)" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="40" Height="40" Padding="0" Content="✕" Foreground="{DynamicResource MaterialDesignBody}" FontSize="14"/>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Code Comparison Views -->
            <Grid Grid.Row="1" Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Original SQL -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBlock Text="原始 SQL (含有标量子查询)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RichTextBox Grid.Row="1" x:Name="OriginalSqlTextBox" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"/>
                </Grid>

                <!-- Right: Optimized SQL -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignPrimaryBrush}"/>
                        <TextBlock Text="优化后的 SQL (LEFT JOIN + GROUP BY)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RichTextBox Grid.Row="1" x:Name="OptimizedSqlTextBox" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"/>
                </Grid>
            </Grid>

            <!-- Bottom Actions -->
            <Border Grid.Row="2" Background="{DynamicResource MaterialDesignBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="提示：优化后的 JOIN 语句消除了标量子查询的嵌套循环执行，能显著提升大数据量下的查询速度。" Foreground="Gray" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="取消 (Cancel)" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Width="120" Margin="0,0,12,0"/>
                        <Button Content="一键快速替换 (Replace)" Click="Apply_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource MaterialDesignPrimaryBrush}" Foreground="White" Width="180"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
