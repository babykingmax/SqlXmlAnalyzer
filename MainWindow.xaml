<Window x:Class="SqlXmlAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SqlXmlAnalyzer"
        xmlns:vm="clr-namespace:SqlXmlAnalyzer.Core.ViewModels"
        Title="{Binding AppTitle}" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- 执行计划操作符模板 (Plan Explorer 风格) -->
        <HierarchicalDataTemplate x:Key="PlanOperatorTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Source="{Binding OperatorIcon}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                <TextBlock Text="{Binding PhysicalOp}" FontWeight="SemiBold" Foreground="{Binding CostColor}"/>
                <TextBlock Text=" (" Foreground="Gray"/>
                <TextBlock Text="{Binding LogicalOp}" Foreground="Gray"/>
                <TextBlock Text=")" Foreground="Gray"/>
                <TextBlock Text="  Cost: " Foreground="#666"/>
                <TextBlock Text="{Binding Cost, StringFormat={}{0:F2}}" Foreground="{Binding CostColor}"/>
                <TextBlock Text="  Rows: " Foreground="#666"/>
                <TextBlock Text="{Binding EstRows}" Foreground="#666"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- 死锁等待关系模板 -->
        <HierarchicalDataTemplate x:Key="DeadlockRelationTemplate" ItemsSource="{Binding Waiters}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔒 " />
                <TextBlock Text="{Binding ResourceName}" FontWeight="SemiBold"/>
                <TextBlock Text="  被 " />
                <TextBlock Text="{Binding Holder}" Foreground="#0066CC"/>
                <TextBlock Text=" 持有，等待者: " />
                <TextBlock Text="{Binding WaiterCount}" Foreground="Red"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 菜单栏 -->
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部菜单 -->
        <Menu Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="4">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开死锁 XML..." Click="OpenDeadlockFile_Click"/>
                <MenuItem Header="打开执行计划 XML..." Click="OpenPlanFile_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="生成 HTML 报告" Click="GenerateHtmlReport_Click"/>
                <MenuItem Header="打开日志目录" Click="OpenLogsFolder_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 SqlXmlAnalyzer" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="1" Height="48" Background="{StaticResource SurfaceBrush}" Padding="4">
            <Button Content="📂 打开死锁" Click="OpenDeadlockFile_Click" Margin="4,0"/>
            <Button Content="📊 打开执行计划" Click="OpenPlanFile_Click" Margin="4,0"/>
            <Separator Margin="8,0"/>
            <Button Content="🌐 导出 HTML" Click="GenerateHtmlReport_Click" Margin="4,0"/>
            <Button Content="📄 导出 Word" Style="{StaticResource SecondaryButtonStyle}" Click="ExportToWord_Click" Margin="4,0" ToolTip="导出当前诊断报告为 Word 文档 (.docx)"/>
            <Button Content="📄 导出 PDF" Style="{StaticResource SecondaryButtonStyle}" Click="ExportToPdf_Click" Margin="4,0" ToolTip="导出当前诊断报告为 PDF 文档 (.pdf)"/>
            <Button Content="🎭 脱敏导出" Style="{StaticResource SecondaryButtonStyle}" Click="ExportObfuscatedPlan_Click" Margin="4,0" ToolTip="保留核心DOM结构去除敏感字符串(库表/SQL语句等)导出安全的脱敏XML文件"/>
            <Button Content="📋 复制结果" Style="{StaticResource SecondaryButtonStyle}" Click="CopyAnalysisResult_Click" Margin="4,0" ToolTip="一键复制诊断与分析结果到剪贴板"/>
            <Separator Margin="8,0"/>
            <Button Content="🧹 清空结果" Style="{StaticResource SecondaryButtonStyle}" Click="ClearResults_Click" Margin="4,0"/>
        </ToolBar>

        <!-- 主内容区 - 参考 SQL Sentry Plan Explorer 风格 -->
        <TabControl Grid.Row="2" Margin="6" Name="MainTabControl" SelectedIndex="0">

            <!-- ==================== 死锁分析 Tab (A) ==================== -->
            <TabItem Header="🔴 死锁分析" Margin="0,0,-16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DeadlockLeftColumn" Width="280" MinWidth="0"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition x:Name="DeadlockRightColumn" Width="320" MinWidth="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：进程与资源列表 -->
                    <Grid Grid.Column="0" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="参与进程 (Processes)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListView Grid.Row="1" Name="DeadlockProcessesList" 
                                  SelectionChanged="DeadlockProcessesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="SPID" DisplayMemberBinding="{Binding Spid}" Width="45"/>
                                    <GridViewColumn Header="事务" DisplayMemberBinding="{Binding TransactionName}" Width="80"/>
                                    <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="65"/>
                                    <GridViewColumn Header="登录账号" DisplayMemberBinding="{Binding Loginname}" Width="120"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Grid.Row="2" Text="涉及资源 (Resources)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ListView Grid.Row="3" Name="DeadlockResourcesList" 
                                  SelectionChanged="DeadlockResourcesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="资源" DisplayMemberBinding="{Binding LockType}" Width="55"/>
                                    <GridViewColumn Header="涉及数据表" DisplayMemberBinding="{Binding CleanTableName}" Width="110"/>
                                    <GridViewColumn Header="锁流向冲突" DisplayMemberBinding="{Binding ConflictSummary}" Width="115"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <!-- 中间：死锁关系可视化 (纯 WPF 原生控件) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="4,2,4,4">
                            <TextBlock Text="死锁等待图 (原生拓扑视图)" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Foreground="#1E2B3C"/>
                            <ComboBox x:Name="XelDeadlockSelector" Width="170" Margin="12,0,4,0" Visibility="Collapsed" SelectionChanged="XelDeadlockSelector_SelectionChanged" DisplayMemberPath="Timestamp" ToolTip="选择 XEL 文件中的死锁记录"/>
                            <Button x:Name="ToggleLeftBtn" Content="◀ 侧边栏" Click="ToggleLeft_Click" Margin="4,0,4,0" Padding="8,2" Background="#EEEEEE" BorderBrush="#CCCCCC" ToolTip="收起/展开左侧进程和资源面板"/>
                            <Button x:Name="ToggleRightBtn" Content="属性栏 ▶" Click="ToggleRight_Click" Margin="4,0" Padding="8,2" Background="#EEEEEE" BorderBrush="#CCCCCC" ToolTip="收起/展开右侧类型诊断和详情面板"/>
                            <Button Content="🔍 适屏" Click="ZoomToFitDeadlock_Click" Margin="4,0,8,0" Padding="8,2" ToolTip="自适应缩放并平移以使全部节点适配当前窗口尺寸"/>
                            <Button Content="复制 Mermaid" Click="CopyDeadlockMermaid_Click" Margin="4,0" Padding="6,2"/>
                            <Button Content="浏览器大图" Click="OpenDeadlockMermaidInBrowser_Click" Margin="4,0" Padding="6,2"/>
                        </StackPanel>

                        <!-- Canvas 图形化死锁等待图 - 支持节点拖拽 + 鼠标滚轮缩放 + 中键平移 (纯 WPF 原生) -->
                        <Border x:Name="DeadlockCanvasBorder" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" ClipToBounds="True">
                            <Canvas x:Name="DeadlockGraphCanvas" Width="1600" Height="1200">
                                <Canvas.Background>
                                    <!-- 专家级微点网格背景 (Visual Brush) -->
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
                                                        <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#F1F1F1" Thickness="0.75"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Canvas.Background>
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="DeadlockScaleTransform" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="DeadlockTranslateTransform" X="0" Y="0"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Border>
                    </Grid>

                    <!-- 右侧：死锁类型诊断 + 详情 -->
                    <Grid Grid.Column="4" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="死锁类型诊断 ( 专家级诊断启发式 )" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox Grid.Row="1" Name="DeadlockPatternsListBox" Margin="0,0,0,4"
                                 SelectionChanged="DeadlockPatternsListBox_SelectionChanged"/>

                        <TextBlock Grid.Row="2" Text="分析与选中项详情 ( Consolas 等宽对齐 )" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="3" Name="DeadlockPatternDetail" Text="{Binding DeadlockPatternText, Mode=TwoWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== 执行计划分析 Tab (B) - 参考 Plan Explorer ==================== -->
            <TabItem Header="📈 执行计划分析" Margin="24,0,-42,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 查询文本 -->
                        <RowDefinition Height="*"/>      <!-- 主区域 -->
                        <RowDefinition Height="Auto"/>   <!-- 底部信息 -->
                    </Grid.RowDefinitions>

                    <!-- 查询文本区域 -->
                    <Expander Grid.Row="0" Header="查询语句 (Statement Text)" ExpandDirection="Down" IsExpanded="False" Margin="4,4,4,12">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" CornerRadius="6">
                            <TextBox Name="PlanStatementTextBox" Height="60" Text="{Binding PlanStatementText, Mode=TwoWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12"/>
                        </Border>
                    </Expander>

                    <Grid Grid.Row="1" x:Name="PlanContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="30"/> <!-- 操作符树 -->
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*" MinWidth="500"/>    <!-- 图形视图 -->
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="280" MinWidth="30"/> <!-- 属性面板 -->
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：操作符树 (类似 Plan Explorer 左侧树) -->
                        <Expander Grid.Column="0" ExpandDirection="Right" IsExpanded="False" Margin="2"
                                  Expanded="LeftPanel_Expanded" Collapsed="LeftPanel_Collapsed">
                            <Expander.Header>
                                <TextBlock Text="操作符树 (Operator Tree)" FontWeight="SemiBold">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Expander.Header>
                            <Grid>
                                <TreeView Name="PlanOperatorTree"
                                          SelectedItemChanged="PlanOperatorTree_SelectedItemChanged"/>
                            </Grid>
                        </Expander>
                        
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" />

                        <!-- 中间：图形化执行计划 (纯 WPF 原生控件，Plan Explorer 风格) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 增强的 TreeView + Nodify 节点编辑器（A + B） - 强烈推荐切换到第二个标签看专业效果 -->
                            <TabControl Grid.Row="1" x:Name="PlanGraphTabControl">
                                <TabItem Header="★ Nodify Graph（专业拖拽操作符盒子 - Plan Explorer 推荐）" IsSelected="True">
                                    <local:PlanGraphControl x:Name="PlanNodifyGraph" NodeSelected="PlanNodifyGraph_NodeSelected" NodeDoubleClicked="PlanNodifyGraph_NodeDoubleClicked"/>
                                </TabItem>
                                <TabItem Header="📄 传统树状图（经典显示）">
                                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                                        <ScrollViewer>
                                            <TreeView Name="PlanVisualTree" 
                                                      ItemTemplate="{StaticResource PlanOperatorTemplate}"
                                                      SelectedItemChanged="PlanVisualTree_SelectedItemChanged"/>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <TabItem Header="🗂️ 全局属性树 (Recosting)">
                                    <DataGrid x:Name="RecostGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ItemsSource="{Binding ElementName=PlanNodifyGraph, Path=Nodes}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Node ID" Binding="{Binding NodeId}" Width="60"/>
                                            <DataGridTextColumn Header="物理操作 (PhysicalOp)" Binding="{Binding PhysicalOp}" Width="160"/>
                                            <DataGridTextColumn Header="逻辑操作 (LogicalOp)" Binding="{Binding LogicalOp}" Width="160"/>
                                            <DataGridTextColumn Header="预估开销 (OwnCost)" Binding="{Binding OwnCost, StringFormat={}{0:F6}}" Width="120"/>
                                            <DataGridTextColumn Header="重算开销 (Recost)" Binding="{Binding ActualRecost, StringFormat={}{0:F6}}" Width="120"/>
                                            <DataGridTextColumn Header="预估行 (EstRows)" Binding="{Binding EstRows}" Width="100"/>
                                            <DataGridTextColumn Header="实际行 (ActRows)" Binding="{Binding ActualRowsRead}" Width="100"/>
                                            <DataGridTextColumn Header="执行模式 (ExecMode)" Binding="{Binding ExecutionMode}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="📄 XML 源码">
                                    <TextBox x:Name="PlanXmlTextBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FDFEFE" Foreground="#17202A"/>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" />

                        <!-- 右侧：属性面板 -->
                        <Expander Grid.Column="4" ExpandDirection="Left" IsExpanded="True" Margin="2"
                                  Expanded="RightPanel_Expanded" Collapsed="RightPanel_Collapsed">
                            <Expander.Header>
                                <TextBlock Text="算子属性 (Properties)" FontWeight="SemiBold">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Expander.Header>
                            <Grid>
                                <DataGrid Name="PlanPropertiesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="#F9FAFB"
                                          RowBackground="White"
                                          Background="White"
                                          BorderBrush="#E0E0E0"
                                          BorderThickness="1">
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <Expander IsExpanded="True" BorderBrush="#D5DFE5" BorderThickness="0,0,0,1">
                                                                    <Expander.Header>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4,0,4"/>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter />
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="属性" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Expander>
                    </Grid>

                    <!-- 底部：警告和建议 (类似 Plan Explorer 底部面板) -->
                    <Expander Grid.Row="2" Header="执行计划深度诊断报告 (Deep Diagnostic Report) ★ 13 类专家调优建议" ExpandDirection="Up" IsExpanded="True" Margin="4">
                        <Border Background="#FFF9E6" BorderBrush="#FFD54F" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,8,0,0">
                            <TextBox Name="PlanWarningsTextBox" Height="120" Text="{Binding PlanWarningsText, Mode=TwoWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="12"/>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Height="32" Background="{StaticResource AccentBrush}" Foreground="White">
            <StatusBarItem>
                <TextBlock Name="StatusTextBlock" Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Background="#88FFFFFF"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="SqlXmlAnalyzer v2.0 | 2026 Modern UI" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>