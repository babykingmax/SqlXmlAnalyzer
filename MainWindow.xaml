<Window x:Class="SqlXmlAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SqlXmlAnalyzer"
        xmlns:vm="clr-namespace:SqlXmlAnalyzer.Core.ViewModels"
        xmlns:views="clr-namespace:SqlXmlAnalyzer.Views"
        xmlns:conv="clr-namespace:SqlXmlAnalyzer.Converters"
        Title="{Binding AppTitle}"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/> <!-- 标题栏 -->
            <RowDefinition Height="*"/>  <!-- 内容区 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 自定义沉浸式标题栏 -->
        <views:ShellTitleBar Grid.Row="0"
                             TitleBarMouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                             MinimizeClicked="Minimize_Click"
                             MaximizeClicked="Maximize_Click"
                             CloseClicked="Close_Click"/>

        <!-- 主内容区: 左侧 Navigation Rail + 右侧 TabControl -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 现代化侧边导航 (Navigation Rail) -->
            <views:ShellNavigationRail x:Name="NavigationRail"
                                       Grid.Column="0"
                                       OpenDeadlockClicked="OpenDeadlockFile_Click"
                                       OpenPlanClicked="OpenPlanFile_Click"
                                       GenerateHtmlReportClicked="GenerateHtmlReport_Click"
                                       ExportWordClicked="ExportToWord_Click"
                                       ExportPdfClicked="ExportToPdf_Click"
                                       ExportObfuscatedPlanClicked="ExportObfuscatedPlan_Click"
                                       CopyAnalysisResultClicked="CopyAnalysisResult_Click"
                                       ClearResultsClicked="ClearResults_Click"
                                       ThemeToggled="ThemeToggle_Click"
                                       AboutClicked="About_Click"/>
            
            <!-- 主内容区 Tabs -->
<TabControl Grid.Column="1" Margin="2" Name="MainTabControl" SelectedIndex="0" Background="{DynamicResource MaterialDesignPaper}">

            <!-- ==================== 死锁分析 Tab (A) ==================== -->
            <TabItem Header="🔴 死锁分析" Margin="0,0,-16,0">

    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DeadlockLeftColumn" Width="280" MinWidth="0"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition x:Name="DeadlockRightColumn" Width="320" MinWidth="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：进程与资源列表 -->
                    <Grid Grid.Column="0" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="参与进程 (Processes)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListView Grid.Row="1" Name="DeadlockProcessesList" 
                                  SelectionChanged="DeadlockProcessesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="SPID" DisplayMemberBinding="{Binding Spid}" Width="45"/>
                                    <GridViewColumn Header="事务" DisplayMemberBinding="{Binding TransactionName}" Width="80"/>
                                    <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="65"/>
                                    <GridViewColumn Header="登录账号" DisplayMemberBinding="{Binding Loginname}" Width="120"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Grid.Row="2" Text="涉及资源 (Resources)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ListView Grid.Row="3" Name="DeadlockResourcesList" 
                                  SelectionChanged="DeadlockResourcesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="资源" DisplayMemberBinding="{Binding LockType}" Width="55"/>
                                    <GridViewColumn Header="涉及数据表" DisplayMemberBinding="{Binding CleanTableName}" Width="110"/>
                                    <GridViewColumn Header="锁流向冲突" DisplayMemberBinding="{Binding ConflictSummary}" Width="115"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <!-- 中间：死锁关系可视化 (纯 WPF 原生控件) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="4,2,4,4">
                            <TextBlock Text="死锁等待图 (原生拓扑视图)" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <ComboBox x:Name="XelDeadlockSelector" Width="170" Margin="12,0,4,0" Visibility="Collapsed" SelectionChanged="XelDeadlockSelector_SelectionChanged" DisplayMemberPath="Timestamp" ToolTip="选择 XEL 文件中的死锁记录"/>
                            <Button x:Name="ToggleLeftBtn" Content="◀ 侧边栏" Click="ToggleLeft_Click" Margin="4,0,4,0" Padding="8,2" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" ToolTip="收起/展开左侧进程和资源面板"/>
                            <Button x:Name="ToggleRightBtn" Content="属性栏 ▶" Click="ToggleRight_Click" Margin="4,0" Padding="8,2" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" ToolTip="收起/展开右侧类型诊断和详情面板"/>
                            <Button Content="🔍 适屏" Click="ZoomToFitDeadlock_Click" Margin="4,0,8,0" Padding="8,2" ToolTip="自适应缩放并平移以使全部节点适配当前窗口尺寸"/>
                            <ToggleButton x:Name="PlaybackModeToggle" Content="🎬 回放模式" Checked="PlaybackModeToggle_Checked" Unchecked="PlaybackModeToggle_Unchecked" Margin="4,0" Padding="8,2" FontWeight="SemiBold" Foreground="#1976D2"/>
                            <Button Content="复制 Mermaid" Click="CopyDeadlockMermaid_Click" Margin="4,0" Padding="6,2"/>
                            <Button Content="浏览器大图" Click="OpenDeadlockMermaidInBrowser_Click" Margin="4,0" Padding="6,2"/>
                        </StackPanel>


                        <!-- Canvas 图形化死锁等待图 - 支持节点拖拽 + 鼠标滚轮缩放 + 中键平移 (纯 WPF 原生) -->
                        <Border x:Name="DeadlockCanvasBorder" Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="2" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="6" ClipToBounds="True">
                            <Canvas x:Name="DeadlockGraphCanvas" Width="1600" Height="1200">
                                <Canvas.Background>
                                    <!-- 专家级微点网格背景 (Visual Brush) -->
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
                                                        <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#F1F1F1" Thickness="0.75"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Canvas.Background>
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="DeadlockScaleTransform" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="DeadlockTranslateTransform" X="0" Y="0"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Border>

                        <views:DeadlockPlaybackControl x:Name="PlaybackControl" Grid.Row="1" VerticalAlignment="Top" Margin="10,10,10,0" Panel.ZIndex="10" Visibility="Collapsed" />
                    </Grid>

                    <!-- 右侧：死锁类型诊断 + 详情 -->
                    <Grid Grid.Column="4" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="死锁类型诊断 ( 专家级诊断启发式 )" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox Grid.Row="1" Name="DeadlockPatternsListBox" Margin="0,0,0,4"
                                 SelectionChanged="DeadlockPatternsListBox_SelectionChanged"/>

                        <TextBlock Grid.Row="2" Text="分析与选中项详情 ( Consolas 等宽对齐 )" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="3" Name="DeadlockPatternDetail" Text="{Binding DeadlockPatternText, Mode=TwoWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== 执行计划分析 Tab (B) - 参考 Plan Explorer ==================== -->
            <TabItem Header="📈 执行计划分析" Margin="24,0,-42,0">

    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 查询文本 -->
                        <RowDefinition Height="*"/>
                        <!-- 主区域 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 底部信息 -->
                    </Grid.RowDefinitions>

                    <!-- 查询文本区域 -->
                    <Expander Grid.Row="0" Header="查询语句 (Statement Text)" ExpandDirection="Down" IsExpanded="False" Margin="2,0,2,4">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" CornerRadius="6">
                            <TextBox Name="PlanStatementTextBox" Height="60" Text="{Binding PlanStatementText, Mode=TwoWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12"/>
                        </Border>
                    </Expander>

                    <Grid Grid.Row="1" x:Name="PlanContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="30"/>
                            <!-- 操作符树 -->
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*" MinWidth="500"/>
                            <!-- 图形视图 -->
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="280" MinWidth="30"/>
                            <!-- 属性面板 -->
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：操作符树 (类似 Plan Explorer 左侧树) -->
                        <Expander Grid.Column="0" ExpandDirection="Right" IsExpanded="False" Margin="2"
                                  Expanded="LeftPanel_Expanded" Collapsed="LeftPanel_Collapsed">
                            <Expander.Header>
                                <TextBlock Text="操作符树 (Operator Tree)" FontWeight="SemiBold">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Expander.Header>

    <Grid>
                                <TreeView Name="PlanOperatorTree"
                                          SelectedItemChanged="PlanOperatorTree_SelectedItemChanged"/>
                            </Grid>
                        </Expander>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" />

                        <!-- 中间：图形化执行计划 (纯 WPF 原生控件，Plan Explorer 风格) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 增强的 TreeView + Nodify 节点编辑器（A + B） - 强烈推荐切换到第二个标签看专业效果 -->
                            <TabControl Grid.Row="1" x:Name="PlanGraphTabControl" Margin="0,2,0,0">
                                <TabItem Header="★ Nodify Graph（专业拖拽操作符盒子 - Plan Explorer 推荐）" IsSelected="True">
                                    <local:PlanGraphControl x:Name="PlanNodifyGraph" NodeSelected="PlanNodifyGraph_NodeSelected" NodeDoubleClicked="PlanNodifyGraph_NodeDoubleClicked"/>
                                </TabItem>
                                <TabItem Header="📄 传统树状图（经典显示）">
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Background="{DynamicResource MaterialDesignPaper}">
                                        <ScrollViewer>
                                            <TreeView Name="PlanVisualTree" 
                                                      ItemTemplate="{StaticResource PlanOperatorTemplate}"
                                                      SelectedItemChanged="PlanVisualTree_SelectedItemChanged"/>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <TabItem Header="🗂️ 全局属性树 (Recosting)">
                                    <DataGrid x:Name="RecostGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ItemsSource="{Binding ElementName=PlanNodifyGraph, Path=Nodes}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Node ID" Binding="{Binding NodeId}" Width="60"/>
                                            <DataGridTextColumn Header="物理操作 (PhysicalOp)" Binding="{Binding PhysicalOp}" Width="160"/>
                                            <DataGridTextColumn Header="逻辑操作 (LogicalOp)" Binding="{Binding LogicalOp}" Width="160"/>
                                            <DataGridTextColumn Header="预估开销 (OwnCost)" Binding="{Binding OwnCost, StringFormat={}{0:F6}}" Width="120"/>
                                            <DataGridTextColumn Header="重算开销 (Recost)" Binding="{Binding ActualRecost, StringFormat={}{0:F6}}" Width="120"/>
                                            <DataGridTextColumn Header="预估行 (EstRows)" Binding="{Binding EstRows}" Width="100"/>
                                            <DataGridTextColumn Header="实际行 (ActRows)" Binding="{Binding ActualRowsRead}" Width="100"/>
                                            <DataGridTextColumn Header="执行模式 (ExecMode)" Binding="{Binding ExecutionMode}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="📄 XML 源码" Margin="0,0,3,0">
                                    <TextBox x:Name="PlanXmlTextBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </TabItem>
                                <TabItem x:Name="SqlRefactorTab" Header="✨ T-SQL 智能重构" Margin="0,0,3,0">
                                    <Grid Background="{DynamicResource MaterialDesignPaper}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Top Info/Action bar -->
                                        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignBackground}" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="AutoFix" Foreground="#1976D2" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0"/>
                                                    <TextBlock Text="AST 静态规则引擎已自动扫描并重构了查询语句中的反模式（如隐式转换、表变量等）" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="复制重构 SQL" Click="CopyRefactoredSql_Click" Margin="0,0,8,0" Padding="12,2" Style="{StaticResource MaterialDesignFlatButton}"/>
                                                    <Button Content="隐藏原始 SQL" x:Name="BtnCompareSql" Click="CompareSql_Click" Padding="12,2" Style="{StaticResource MaterialDesignFlatButton}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Side-by-Side SQL view -->
                                        <Grid Grid.Row="1" Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" x:Name="OriginalSqlCol"/>
                                                <ColumnDefinition Width="4" x:Name="SqlSplitterCol"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Original SQL -->
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="#F5F5F5" Padding="4,2" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                    <TextBlock Text="原始 SQL 语句" FontWeight="SemiBold" Foreground="#666" FontSize="11" HorizontalAlignment="Center"/>
                                                </Border>
                                                <RichTextBox Grid.Row="1" x:Name="OriginalSqlTextBox" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                                    <RichTextBox.Resources>
                                                        <Style TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Margin" Value="0"/>
                                                        </Style>
                                                    </RichTextBox.Resources>
                                                </RichTextBox>
                                            </Grid>
                                            
                                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" x:Name="SqlGridSplitter"/>
                                            
                                            <!-- Refactored SQL -->
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="#E3F2FD" Padding="4,2" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" BorderBrush="#BBDEFB">
                                                    <TextBlock Text="重构后 SQL 语句 (优化版)" FontWeight="SemiBold" Foreground="#1565C0" FontSize="11" HorizontalAlignment="Center"/>
                                                </Border>
                                                <RichTextBox Grid.Row="1" x:Name="RefactoredSqlTextBox" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#BBDEFB" BorderThickness="1">
                                                    <RichTextBox.Resources>
                                                        <Style TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Margin" Value="0"/>
                                                        </Style>
                                                    </RichTextBox.Resources>
                                                </RichTextBox>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="📊 参数嗅探直方图 (Histogram)" Margin="0,0,-19,0">
                                    <local:StatisticsHistogramControl x:Name="StatisticsHistogramView"/>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" />

                        <!-- 右侧：属性面板 -->
                        <Expander Grid.Column="4" ExpandDirection="Left" IsExpanded="True" Margin="2"
                                  Expanded="RightPanel_Expanded" Collapsed="RightPanel_Collapsed">
                            <Expander.Header>
                                <TextBlock Text="算子属性 (Properties)" FontWeight="SemiBold">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Expander.Header>

    <Grid>
                                <DataGrid Name="PlanPropertiesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                          BorderThickness="1">
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <Expander IsExpanded="True" BorderBrush="#D5DFE5" BorderThickness="0,0,0,1">
                                                                    <Expander.Header>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4,0,4"/>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter />
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="属性" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Expander>
                    </Grid>

                    <!-- 底部：警告和建议 (类似 Plan Explorer 底部面板) -->
                    <Expander Grid.Row="2" Header="执行计划深度诊断报告 (★ 13类专家建议)" ExpandDirection="Up" IsExpanded="True" Margin="2,4,2,0">
                        <Border Background="#FFF9E6" BorderBrush="#FFD54F" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,8,0,0">

    <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding MissingIndexes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <!-- Header row: Table, Score/Impact, Sandbox Button -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📋 建议索引于 " FontWeight="Bold" FontSize="14" Foreground="#1565C0"/>
                                                                <TextBlock Text="{Binding Table}" FontWeight="Bold" FontSize="14" Foreground="#1565C0"/>
                                                                <TextBlock Text="{Binding Schema, StringFormat=' ({0})'}" Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            
                                                            <TextBlock Grid.Column="1" Text="{Binding Impact, StringFormat='提升: {0:F2}%'}" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                                            
                                                            <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat='⭐ 评分: {0}/100'}" 
                                                                       Foreground="{Binding Score, Converter={StaticResource ScoreColorConv}}" 
                                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                                                                       
                                                            <Button Grid.Column="3" Content="🛠️ 沙盒模拟" Width="100" Height="28" 
                                                                    Command="{Binding DataContext.OpenSandboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}"
                                                                    Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                                        </Grid>
                                                        
                                                        <!-- CREATE INDEX DDL Box & Copy Button -->
                                                        <Grid Grid.Row="1" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding CreateIndexStatement, Mode=OneWay}" IsReadOnly="True" 
                                                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6" Height="60" VerticalScrollBarVisibility="Auto"/>
                                                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Button Content="📋 复制 DDL" Width="120" Height="28" Margin="0,0,0,4"
                                                                        Click="CopyIndexDdl_Click" Tag="{Binding CreateIndexStatement}" Cursor="Hand"/>
                                                                <Button Content="📦 复制部署包" Width="120" Height="28"
                                                                        Click="CopyDeploymentBundle_Click" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <!-- DROP INDEX (Rollback) DDL Box & Copy Button -->
                                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding RollbackStatement, Mode=OneWay}" IsReadOnly="True" 
                                                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" Padding="6" Height="40" VerticalScrollBarVisibility="Auto"/>
                                                            <Button Grid.Column="1" Content="↩️ 复制回滚" Margin="8,0,0,0" VerticalAlignment="Center" Width="120" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                                                                    Click="CopyRollbackDdl_Click" Tag="{Binding RollbackStatement}" Cursor="Hand"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBox Grid.Row="1" Name="PlanWarningsTextBox" Height="120" Text="{Binding PlanWarningsText, Mode=TwoWay}"
                                         IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12"/>
                            </Grid>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

            <!-- ==================== A/B 并排对比 Tab (C) ==================== -->
            <TabItem Header="⚖️ A/B 比对分析" Margin="42,0,-60,0">
                <Grid Background="{DynamicResource MaterialDesignPaper}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="200"/>
                        <!-- 调优历史列表 -->
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <!-- 并排对比控制板 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：调优历史 (Tuning History) -->
                    <Grid Grid.Column="0" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <TextBlock Text="调优版本历史 (Tuning History)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,2">
                                <Button Content="📸 捕获当前计划" Command="{Binding CaptureCurrentPlanCommand}" Height="28" Margin="0,0,4,0" ToolTip="将当前查看的执行计划加入调优历史列表中"/>
                                <Button Content="🧹 清空历史" Command="{Binding ClearHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="28" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 历史快照列表 -->
                        <ListView Grid.Row="1" ItemsSource="{Binding TuningHistory}" x:Name="TuningHistoryListView" MouseDoubleClick="TuningHistoryListView_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2" ToolTip="右键设置计划A/B对比，或双击载入主视图">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#37474F"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Cost: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding TotalCost, StringFormat={}{0:F4}}" FontWeight="Bold" Foreground="#0078D7" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="Ops: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding OperatorCount}" Foreground="#37474F" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="Idx: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding MissingIndexCount}" Foreground="#EF6C00" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{Binding ShortStatementText}" Foreground="#546E7A" FontSize="10" FontStyle="Italic"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="设为 [计划 A] (基准)" Command="{Binding PlacementTarget.Tag.SetAsPlanACommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="设为 [计划 B] (优化后)" Command="{Binding PlacementTarget.Tag.SetAsPlanBCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="删除快照" Command="{Binding PlacementTarget.Tag.RemoveSnapshotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- 会话保存与加载 -->
                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="💾 保存会话 (.pesession)" Click="SaveSession_Click" Height="30" Margin="0,0,4,0" ToolTip="保存当前所有的调优历史记录及计划文档到会话文件"/>
                                <Button Content="📂 加载会话" Click="LoadSession_Click" Style="{StaticResource SecondaryButtonStyle}" Height="30" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDDDDD" />

                    <!-- 右侧：对比区域 -->
                    <Grid Grid.Column="2" Margin="6">
                        <!-- 未设置对比计划时的占位信息 -->
                        <Grid Visibility="{Binding CompareVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate, FallbackValue=Visible}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚖️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="请在左侧调优历史中选中并右键设置『计划 A』和『计划 B』来进行并排差异对比。" 
                                           Foreground="#78909C" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="提示：可以右键选中快照并设为计划 A/B；双击快照可以将其重新载入主窗口进行详细诊断。" 
                                           Foreground="#B0BEC5" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>

                        <!-- A/B 并排对比核心面板 -->
                        <Grid Visibility="{Binding CompareVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- 顶部对比卡片 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 查询语句对比 -->
                                <RowDefinition Height="*"/>
                                <!-- 树状差异并排 -->
                            </Grid.RowDefinitions>

                            <!-- 顶部对比卡片 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 计划 A 卡片 (基准) -->
                                <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#0078D7" BorderThickness="2,1,1,1" CornerRadius="4" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="[计划 A] (基准)" FontSize="11" Foreground="#0078D7" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PlanA.Title}" FontSize="13" FontWeight="Bold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="总估算成本" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanA.TotalCost, StringFormat={}{0:F4}}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="算子数量" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanA.OperatorCount}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="缺失索引" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanA.MissingIndexCount}" FontSize="16" FontWeight="Bold" Foreground="#EF6C00"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 差异分析中心指示卡 -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="8,4" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="性能变动幅度" FontSize="10" Foreground="#78909C" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CostDeltaText}" FontSize="16" FontWeight="Bold" Foreground="{Binding CostDeltaColor}" HorizontalAlignment="Center" Margin="0,4"/>
                                        <Button Content=" 🔁 交换 A/B " Click="SwapPlanAB_Click" FontSize="10" Padding="8,2" Height="22" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 计划 B 卡片 (优化后) -->
                                <Border Grid.Column="2" Background="#F5F7FA" BorderBrush="#2E7D32" BorderThickness="2,1,1,1" CornerRadius="4" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="[计划 B] (优化后)" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PlanB.Title}" FontSize="13" FontWeight="Bold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="总估算成本" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanB.TotalCost, StringFormat={}{0:F4}}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="算子数量" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanB.OperatorCount}" FontSize="16" FontWeight="Bold" Foreground="#37474F"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="缺失索引" FontSize="10" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding PlanB.MissingIndexCount}" FontSize="16" FontWeight="Bold" Foreground="#EF6C00"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 查询语句对比 -->
                            <Expander Grid.Row="1" Header="查询语句对比 (SQL Statements)" ExpandDirection="Down" IsExpanded="False" Margin="4,0,4,8">

    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="50" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding PlanA.StatementText}" FontFamily="Consolas" FontSize="10" Background="{DynamicResource MaterialDesignPaper}" VerticalScrollBarVisibility="Auto"/>
                                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
                                    <TextBox Grid.Column="2" Height="50" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding PlanB.StatementText}" FontFamily="Consolas" FontSize="10" Background="{DynamicResource MaterialDesignPaper}" VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Expander>

                            <!-- 树状差异并排 -->
                            <Grid Grid.Row="2" Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 计划 A 的 TreeView -->
                                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">

    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#F5F7FA" Padding="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="计划 A 操作符结构树" FontWeight="SemiBold" FontSize="11" Foreground="#546E7A"/>
                                        </Border>
                                        <TreeView Grid.Row="1" x:Name="PlanATreeView" BorderThickness="0"/>
                                    </Grid>
                                </Border>

                                <!-- 计划 B 的 TreeView -->
                                <Border Grid.Column="2" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">

    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#F5F7FA" Padding="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="计划 B 操作符结构树" FontWeight="SemiBold" FontSize="11" Foreground="#546E7A"/>
                                        </Border>
                                        <TreeView Grid.Row="1" x:Name="PlanBTreeView" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>

        <!-- 状态栏 -->
        <views:ShellStatusBar x:Name="ShellStatus" Grid.Row="2"/>
    </Grid>
</Window>