<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple>
          <QueryPlan>
            <RelOp NodeId="0" PhysicalOp="Index Scan" LogicalOp="Index Scan">
              <IndexScan>
                <Object Database="[TestDB]" Schema="[dbo]" Table="[Users]" />
