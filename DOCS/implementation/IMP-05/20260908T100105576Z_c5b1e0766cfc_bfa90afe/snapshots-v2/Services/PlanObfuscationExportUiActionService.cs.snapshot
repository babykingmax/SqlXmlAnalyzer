using System;
using System.Windows;
using System.Xml.Linq;

namespace SqlXmlAnalyzer.Services
{
    internal sealed class PlanObfuscationExportUiActionService
    {
        private readonly Core.Services.IFileDialogService _fileDialogService;
        private readonly SqlXmlAnalyzer.Application.Services.RedactedPlanExportService _exporter;
        private readonly Action<string, string, MessageBoxButton, MessageBoxImage> _showMessage;

        public PlanObfuscationExportUiActionService(
            Core.Services.IFileDialogService fileDialogService,
            SqlXmlAnalyzer.Application.Services.RedactedPlanExportService? exporter = null,
            Action<string, string, MessageBoxButton, MessageBoxImage>? showMessage = null)
        {
            _fileDialogService = fileDialogService
                ?? throw new ArgumentNullException(nameof(fileDialogService));
            _exporter = exporter ?? new SqlXmlAnalyzer.Application.Services.RedactedPlanExportService();
            _showMessage = showMessage ?? ((message, title, buttons, icon) => MessageBox.Show(message, title, buttons, icon));
        }

        public void Export(
            XDocument? currentPlanDocument,
            Action<string> setStatus)
        {
            ArgumentNullException.ThrowIfNull(setStatus);

            if (currentPlanDocument == null)
            {
                _showMessage("Please load an execution plan first.", "Notice", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            try
            {
                setStatus("正在检查脱敏覆盖范围...");
                var redaction = Core.Services.PlanObfuscatorService.RedactPlan(currentPlanDocument);
                string categories = string.Join("\n", redaction.MaskedCounts.Select(item => $"{item.Key}: {item.Value}"));
                string unsupported = string.Join("\n", redaction.UnsupportedCounts.Select(item => $"{item.Key}: {item.Value}"));
                if (!redaction.CanExport)
                {
                    _showMessage(redaction.Summary + "\n" + unsupported, "脱敏导出已停止", MessageBoxButton.OK, MessageBoxImage.Warning);
                    setStatus("脱敏覆盖不完整，未导出");
                    return;
                }
                _showMessage(redaction.Summary + "\n\n处理类别：\n" + categories, "脱敏摘要", MessageBoxButton.OK, MessageBoxImage.Information);
                string? fileName = _fileDialogService.ShowSaveFile(
                    new Core.Services.FileDialogRequest(
                        "Execution plan files (*.sqlplan)|*.sqlplan|XML files (*.xml)|*.xml",
                        "保存脱敏副本（请使用新的文件名）",
                        ".sqlplan",
                        "Obfuscated_Plan.sqlplan"));

                if (fileName == null)
                {
                    setStatus("已取消脱敏导出");
                    return;
                }
                setStatus("Generating obfuscated plan...");
                var export = _exporter.Export(redaction, fileName);
                _showMessage(export.Message, export.IsSuccess ? "脱敏副本已保存" : "脱敏导出失败", MessageBoxButton.OK,
                    export.IsSuccess ? MessageBoxImage.Information : MessageBoxImage.Error);
                setStatus(export.IsSuccess ? "脱敏副本已保存" : "脱敏导出失败");
            }
            catch (Exception ex)
            {
                string detail = Core.Diagnostics.ExceptionPolicy.Describe(ex, "ExportObfuscatedPlan_Click");
                _showMessage($"Export failed:\n{detail}", "Failed", MessageBoxButton.OK, MessageBoxImage.Error);
                setStatus("Obfuscated export failed");
            }
        }
    }
}
