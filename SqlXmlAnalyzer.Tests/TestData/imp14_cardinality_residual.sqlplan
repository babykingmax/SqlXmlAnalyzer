          <sp:Predicate><sp:ScalarOperator ScalarString="[T].[V]=(2)"/><sp:ScalarOperator ScalarString="[T].[A]=(3)"/></sp:Predicate>
        </sp:IndexScan>
        <sp:RunTimeInformation><sp:RunTimeCountersPerThread Thread="0" ActualRows="10000" ActualRowsRead="100000" ActualExecutions="1"/></sp:RunTimeInformation>
