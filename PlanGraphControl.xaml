<UserControl x:Class="SqlXmlAnalyzer.PlanGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:local="clr-namespace:SqlXmlAnalyzer"
             xmlns:graphServices="clr-namespace:SqlXmlAnalyzer.Core.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             PreviewKeyDown="Graph_PreviewKeyDown" Focusable="True" AutomationProperties.Name="执行计划图">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PlanGraphToolTip" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PlanTooltipSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border x:Name="TooltipSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource PlanGraphToolTip}"/>
        <Style x:Key="PlanNodeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreviewingSelection, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GraphButton" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="指标" Margin="4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbViewMode" SelectedIndex="0" Width="138" MinHeight="28" Margin="2" AutomationProperties.Name="图指标"
                              SelectionChanged="CmbViewMode_SelectionChanged">
                        <ComboBoxItem Content="估算成本占比"/>
                        <ComboBoxItem Content="估算 CPU / I/O"/>
                        <ComboBoxItem Content="实际 / 估算行数"/>
                    </ComboBox>
                    <TextBox x:Name="GraphSearch" Width="145" Margin="6,2,0,2" Padding="5,3" MinHeight="28"
                             ToolTip="搜索算子、对象或 Node ID；Enter 查找下一项" AutomationProperties.Name="查找算子"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                    <Button Content="查找" Style="{StaticResource GraphButton}" Click="FindNode_Click"/>
                    <TextBlock x:Name="SearchResultText" Margin="4,0" VerticalAlignment="Center" FontSize="11"/>
                    <Button Content="适应图" Style="{StaticResource GraphButton}" Click="FitGraph_Click" ToolTip="缩放并居中当前分段"/>
                    <Button Content="−" Style="{StaticResource GraphButton}" Click="ZoomOut_Click" AutomationProperties.Name="缩小计划图"/>
                    <Button Content="100%" Style="{StaticResource GraphButton}" Click="ResetZoom_Click" ToolTip="恢复原始大小"/>
                    <Button Content="+" Style="{StaticResource GraphButton}" Click="ZoomIn_Click" AutomationProperties.Name="放大计划图"/>
                    <Button Content="定位选中" Style="{StaticResource GraphButton}" Click="LocateSelected_Click"/>
                    <Button x:Name="DisplaySettingsButton" Content="显示设置" Style="{StaticResource GraphButton}" Click="DisplaySettings_Click"/>
                </WrapPanel>
            </Border>
            <Popup x:Name="DisplaySettingsPopup" PlacementTarget="{Binding ElementName=DisplaySettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" CornerRadius="4">
                    <StackPanel Width="235">
                        <TextBlock Text="显示设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="布局"/>
                        <ComboBox x:Name="CmbLayoutMode" SelectedIndex="0" Margin="0,4,0,10" SelectionChanged="CmbLayoutMode_SelectionChanged">
                            <ComboBoxItem Content="水平"/><ComboBoxItem Content="垂直"/>
                        </ComboBox>
                        <TextBlock Text="成本强度"/>
                        <ComboBox x:Name="CmbColorMode" SelectedIndex="0" Margin="0,4,0,10" SelectionChanged="CmbColorMode_SelectionChanged">
                            <ComboBoxItem Content="估算总成本"/><ComboBoxItem Content="估算 CPU"/><ComboBoxItem Content="估算 I/O"/>
                        </ComboBox>
                        <TextBlock Text="连线粗细"/>
                        <ComboBox x:Name="CmbLinkMetric" SelectedIndex="0" Margin="0,4,0,10" SelectionChanged="CmbLinkMetric_SelectionChanged">
                            <ComboBoxItem Content="输出行数"/><ComboBoxItem Content="数据大小"/>
                        </ComboBox>
                        <CheckBox Content="显示连线数值（近景）" IsChecked="{Binding ShowConnectionLabels}" Margin="0,2,0,10"/>
                        <Button Content="全部展开" Style="{StaticResource GraphButton}" Click="ExpandAll_Click"/>
                        <Button Content="折叠低成本无警告子树" Style="{StaticResource GraphButton}" Click="SmartCollapse_Click" ToolTip="子树估算成本小于 5%，且无警告"/>
                    </StackPanel>
                </Border>
            </Popup>
            <local:PlanGraphEditor x:Name="Editor" Grid.Row="1" VirtualizingPanel.IsVirtualizing="False" MinViewportZoom="0.02"
                                 ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Connections="{Binding Connections}"
                                 Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True"
                                 PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown" PreviewMouseMove="Editor_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp">
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PlanNodeViewModel}">
                        <local:AccessiblePlanNode>
                                <Border x:Name="NodeCard" Width="{x:Static graphServices:PlanGraphNodeMetrics.Width}" Height="{x:Static graphServices:PlanGraphNodeMetrics.Height}"
                                        Style="{StaticResource PlanNodeCard}">
                                    <Border.ContextMenu><ContextMenu><MenuItem Header="复制节点信息" Click="CopyNodeInfo_Click"/></ContextMenu></Border.ContextMenu>
                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource PlanGraphToolTip}" Placement="Right" MaxWidth="430" ToolTipService.InitialShowDelay="350">
                                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Width="350">
                                                    <TextBlock Text="{Binding PhysicalOp}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding NodeId, StringFormat='Node {0}'}" Margin="0,3"/>
                                                    <TextBlock Text="{Binding ObjectDisplay}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                                    <TextBlock Text="{Binding RowComparisonHelp}" TextWrapping="Wrap" Margin="0,3"/>
                                                    <TextBlock Text="{Binding ActualRowsRead, StringFormat='实际读取总行数：{0}'}"/>
                                                    <TextBlock Text="{Binding ExecutionMode, StringFormat='执行模式：{0}'}"/>
                                                    <TextBlock Text="双击或 Enter 查看完整属性" Margin="0,6"/>
                                                    <StackPanel Visibility="{Binding HasDiagnosticStatusVisible}" Margin="0,8,0,0">
                                                        <Separator Background="{DynamicResource BorderBrush}"/>
                                                        <TextBlock Text="检查运行状态" FontWeight="SemiBold" Margin="0,4"/>
                                                        <TextBox Text="{Binding DiagnosticStatusSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Visibility="{Binding HasWarningVisible}" Margin="0,8,0,0">
                                                        <TextBlock Text="首要问题摘要" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding TopDiagnosticSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="{Binding DynamicBackgroundBrush}" CornerRadius="5,0,0,5"/>
                                        <Grid Grid.Column="1" Margin="8,7,8,6">
                                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="18"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Path x:Name="OperatorIcon" Grid.RowSpan="2" Data="{Binding IconGeometry}" Fill="{Binding IconBrush}"
                                                  Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False"/>
                                            <TextBlock x:Name="OperatorName" Grid.Column="1" Text="{Binding PhysicalOp}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Button x:Name="CollapseNodeButton" Grid.Column="2" Content="{Binding CollapseButtonText}"
                                                    Visibility="{Binding CollapseButtonVisibility}" Click="ToggleCollapse_Click"
                                                    Style="{StaticResource GraphButton}" Width="22" Height="22" FontSize="14" Padding="0" Margin="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding CollapseActionLabel}" AutomationProperties.Name="{Binding CollapseActionLabel}"/>
                                            <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                                <Border x:Name="DiagnosticBadge" DockPanel.Dock="Right" Visibility="{Binding DiagnosticBadgeVisibility}" Padding="4,0" CornerRadius="3" ToolTip="{Binding DiagnosticSummary}" Margin="5,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DiagnosticSeverity}" Value="严重">
                                                                    <Setter Property="Background" Value="{DynamicResource CriticalSurfaceBrush}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DiagnosticSeverity}" Value="警告">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DiagnosticBadgeText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="NodeObjectLabel" Text="{Binding NodeObjectDisplay}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.NodeMetricsVisible, RelativeSource={RelativeSource AncestorType={x:Type local:PlanGraphControl}}, Converter={StaticResource BoolToVis}}"/>
                                            </DockPanel>
                                            <Border Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,3,0,0"
                                                    Visibility="{Binding DataContext.NodeMetricsVisible, RelativeSource={RelativeSource AncestorType={x:Type local:PlanGraphControl}}, Converter={StaticResource BoolToVis}}">
                                                <TextBlock x:Name="NodePrimaryMetric" Text="{Binding PrimaryDisplayValue}" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                                           ToolTip="{Binding PrimaryMetricHelp}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                        </local:AccessiblePlanNode>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>
                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                        <Setter Property="SelectedBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="HighlightBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="SelectedBorderThickness" Value="2"/>
                        <Setter Property="MinWidth" Value="{x:Static graphServices:PlanGraphNodeMetrics.Width}"/>
                        <Setter Property="MinHeight" Value="{x:Static graphServices:PlanGraphNodeMetrics.Height}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type nodify:ItemContainer}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="Node_MouseDoubleClick"/>
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type local:ConnectionViewModel}">
                        <Grid Opacity="{Binding Opacity}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <nodify:LineConnection Source="{Binding SourceLocation}" Target="{Binding TargetLocation}" Stroke="{DynamicResource SecondaryTextBrush}"
                                                   StrokeThickness="{Binding ThicknessValue}" ToolTip="{Binding ToolTipText}"/>
                            <Border Background="{DynamicResource SurfaceBrush}" Padding="4,1" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                    Visibility="{Binding DataContext.ConnectionLabelsVisible, RelativeSource={RelativeSource AncestorType={x:Type local:PlanGraphControl}}, Converter={StaticResource BoolToVis}}">
                                <Border.RenderTransform><TranslateTransform X="{Binding MidpointX}" Y="{Binding MidpointY}"/></Border.RenderTransform>
                                <TextBlock Text="{Binding LabelText}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Border>
                            <Polygon Points="{Binding ArrowPoints}" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Polygon.RenderTransform><TranslateTransform X="{Binding ArrowTransformX}" Y="{Binding ArrowTransformY}"/></Polygon.RenderTransform>
                            </Polygon>
                        </Grid>
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>
            </local:PlanGraphEditor>
            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="打开执行计划文件开始分析" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Visibility="Collapsed"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,3">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding PageDescription}" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="图显示范围"/>
                        <Button Content="上一组" Click="PreviousGraphPage_Click" IsEnabled="{Binding CanPreviousPage}" Style="{StaticResource GraphButton}"/>
                        <Button Content="下一组" Click="NextGraphPage_Click" IsEnabled="{Binding CanNextPage}" Style="{StaticResource GraphButton}"/>
                        <TextBlock Text="{Binding HiddenNodesDescription}" FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
                        <ComboBox x:Name="CrossPageSelector" Width="250" Margin="4,2" DisplayMemberPath="Label" IsEditable="True" IsReadOnly="True" Text="跨页关系：选择算子继续查看" SelectionChanged="CrossPageSelector_SelectionChanged"
                                  AutomationProperties.Name="跨页算子关系" ToolTip="跨页关系：选择父子算子继续查看" Visibility="Collapsed"
                                  MaxDropDownHeight="320" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                        </ComboBox>
                    </WrapPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomDescription, StringFormat='缩放 {0}'}" Margin="10,0,0,0"
                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.Name="当前缩放比例"/>
                        <TextBlock Text="{Binding GraphLegend}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Popup x:Name="ToastPopup" Placement="Center" PlacementTarget="{Binding ElementName=Editor}" StaysOpen="False" IsHitTestVisible="False" AllowsTransparency="True">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" CornerRadius="4"><TextBlock Text="节点信息已复制"/></Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
